/** * ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ *  BANF Bosonto Utsob 2026 ΓÇö Workflow Processing Service v2.0 * ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ * *  Wix Velo Backend Module ΓÇö Deploy to: backend/bosonto-workflow-service.jsw * *  v2.0 Changes: *    Γ£à Clean member-facing emails ΓÇö no agent/pipeline/technical info *    Γ£à Correct FULL household amounts (uses householdMembershipAmount) *    Γ£à Family/spouse detection from CRM household data *    Γ£à "Please verify" prompt in every email *    Γ£à SPOUSE_OVERRIDES for user-confirmed corrections *    Γ£à Continuous email polling (non-stale) * *  Core Principles: *    1. Admin manual edits = BENCHMARK OF TRUTH ΓåÆ CRM auto-corrects *    2. TEST MODE: All emails route to ranadhir.ghosh@gmail.com *    3. BATCH MODE: Admin-gated ΓÇö nothing processes until explicit approval * *  9-Stage Pipeline: *    email_scan ΓåÆ evite_analysis ΓåÆ wf_payment_scan ΓåÆ membership_rec *    ΓåÆ payment_match ΓåÆ payment ΓåÆ comm_verify ΓåÆ drive_signup ΓåÆ event_mgmt * * @module backend/bosonto-workflow-service.jsw */import wixData from 'wix-data';import { currentMember } from 'wix-members-backend';import { sendEmail } from 'backend/email-gateway.jsw';// =====================================================// CONFIGURATION// =====================================================const CONFIG = {  MEMBERS_COLLECTION: 'Members',  CRM_COLLECTION: 'BosontoCRM',  PIPELINE_COLLECTION: 'BosontoPipeline',  AUDIT_COLLECTION: 'BosontoAuditLog',  BATCH_COLLECTION: 'BosontoBatchQueue',  SETTINGS_COLLECTION: 'BosontoSettings',  SENT_EMAILS_COLLECTION: 'SentEmails',  TEST_EMAIL: 'ranadhir.ghosh@gmail.com',  BANF_EMAIL: 'banfjax@gmail.com',  EVENT_NAME: 'Bosonto Utsob 2026',  EVENT_DATE: 'Saturday, March 7, 2026',  PAYMENT_DEADLINE: 'April 30, 2026',  MEMBERSHIP_YEAR: '2026-27',  ZELLE_EMAIL: 'banfjax@gmail.com',  EMAIL_POLL_INTERVAL_SEC: 30,  STAGES: [    'email_scan', 'evite_analysis', 'wf_payment_scan', 'membership_rec',    'payment_match', 'payment', 'comm_verify', 'drive_signup', 'event_mgmt'  ],  // 2026-27 Membership Pricing  PRICING: {    m2_eb:    { family: 375, couple: 290, individual: 215, student: 145, name: 'M2 Premium Early Bird', desc: 'All 17 events + priority seating + cultural workshops' },    m2:       { family: 410, couple: 330, individual: 240, student: 165, name: 'M2 Premium',            desc: 'All 17 events + priority seating + cultural workshops' },    m1:       { family: 280, couple: 255, individual: 140, student: 100, name: 'M1 Regular',            desc: '4 included events + add-on options for others' },    cultural: { family: 180, couple: 140, individual: 100, student:  75, name: 'Cultural Special',      desc: 'Cultural events focus' },    guest:    { family:  50, couple:  35, individual:  25, student:  15, name: 'Guest Pass',            desc: 'Per-event entry' }  }};// ΓöÇΓöÇ Known Spouse Overrides (user-confirmed) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇconst SPOUSE_OVERRIDES = {  'ranadhir.ghosh@gmail.com': { spouseName: 'Moumita Mukherjee (Ghosh)', spouseEmail: 'moumita.mukherje@gmail.com' }  // Note: 'Moumita Mitra' (tinnee223@gmail.com) is spouse for Abhishek Mitra, NOT Ranadhir};// =====================================================// ADMIN AUTH GUARD// =====================================================async function requireAdmin() {  try {    const member = await currentMember.getMember();    if (!member) throw new Error('Not authenticated');    const admin = await wixData.query('Admins')      .eq('email', member.loginEmail)      .eq('isActive', true)      .find({ suppressAuth: true });    if (admin.items.length === 0) throw new Error('Not authorized');    return { id: admin.items[0]._id, email: member.loginEmail, name: admin.items[0].fullName };  } catch (e) {    throw new Error(`Admin access required: ${e.message}`);  }}// =====================================================// AUDIT LOGGING// =====================================================async function audit(action, adminEmail, memberEmail, details) {  try {    await wixData.insert(CONFIG.AUDIT_COLLECTION, {      action, adminEmail, memberEmail,      details: typeof details === 'object' ? JSON.stringify(details) : details,      timestamp: new Date()    }, { suppressAuth: true });  } catch (e) { console.error('Audit log error:', e); }}// =====================================================// SYSTEM SETTINGS// =====================================================export async function getSystemSettings() {  try {    const res = await wixData.query(CONFIG.SETTINGS_COLLECTION)      .eq('key', 'bosonto_2026')      .find({ suppressAuth: true });    if (res.items.length === 0) {      return { testMode: true, batchMode: false, testEmail: CONFIG.TEST_EMAIL, processingStatus: 'idle', lastRunAt: null, emailPollActive: true };    }    return res.items[0].settings;  } catch (e) {    return { testMode: true, batchMode: false, testEmail: CONFIG.TEST_EMAIL, processingStatus: 'idle', emailPollActive: true };  }}export async function updateSystemSettings(newSettings) {  const admin = await requireAdmin();  const existing = await wixData.query(CONFIG.SETTINGS_COLLECTION)    .eq('key', 'bosonto_2026').find({ suppressAuth: true });  const record = {    key: 'bosonto_2026',    settings: { ...await getSystemSettings(), ...newSettings },    updatedBy: admin.email, updatedAt: new Date()  };  if (existing.items.length > 0) { record._id = existing.items[0]._id; await wixData.update(CONFIG.SETTINGS_COLLECTION, record, { suppressAuth: true }); }  else { await wixData.insert(CONFIG.SETTINGS_COLLECTION, record, { suppressAuth: true }); }  await audit('settings_updated', admin.email, null, { newSettings });  return record.settings;}export async function toggleTestMode(enabled) { return updateSystemSettings({ testMode: !!enabled }); }export async function enableBatchProcessing() {  const admin = await requireAdmin();  return updateSystemSettings({ batchMode: true, batchApprovedBy: admin.email, batchApprovedAt: new Date().toISOString() });}export async function disableBatchProcessing() { return updateSystemSettings({ batchMode: false, processingStatus: 'paused' }); }// =====================================================// FAMILY / SPOUSE DETECTION (v2.0)// =====================================================/** * Detect family members from CRM data using multiple strategies: *  1. SPOUSE_OVERRIDES (user-confirmed, highest priority) *  2. householdMembers[] (CRM-linked) *  3. householdDisplayName parsing ("X & Y Lastname") *  4. Payment rawName parsing ("Name1 Da/ Name2 Di") *  5. familyMembers[] (extended family) * * @param {Object} crm - CRM record * @returns {Object} { spouseName, spouseEmail, childrenCount, familyLabel, confidence, allMembers[] } */function detectFamily(crm) {  const result = { spouseName: null, spouseEmail: null, childrenCount: crm.inferredKids || 0, familyLabel: null, confidence: 'none', allMembers: [] };  const emailKey = (crm.email || '').toLowerCase();  // 1. User-confirmed overrides  if (SPOUSE_OVERRIDES[emailKey]) {    const ov = SPOUSE_OVERRIDES[emailKey];    result.spouseName = ov.spouseName;    result.spouseEmail = ov.spouseEmail;    result.confidence = 'confirmed';    result.allMembers.push({ name: ov.spouseName, relationship: 'spouse', email: ov.spouseEmail });  }  // 2. householdMembers  if (!result.spouseName && (crm.householdMembers || []).length > 0) {    const hm = crm.householdMembers[0];    result.spouseName = hm.displayName || `${hm.firstName || ''} ${hm.lastName || ''}`.trim();    result.spouseEmail = hm.email;    result.confidence = 'high';    result.allMembers.push({ name: result.spouseName, relationship: 'spouse', email: hm.email });  }  // 3. householdDisplayName "X & Y Lastname"  if (!result.spouseName && crm.householdDisplayName) {    const match = crm.householdDisplayName.match(/^(.+?)\s*&\s*(.+)/);    if (match) {      const memberFirst = (crm.firstName || '').toLowerCase();      const spouse = match[1].toLowerCase().includes(memberFirst) ? match[2].trim() : match[1].trim();      if (spouse) { result.spouseName = spouse; result.confidence = 'medium'; result.allMembers.push({ name: spouse, relationship: 'spouse (from records)', email: null }); }    }  }  // 4. Payment rawName slash patterns  if (!result.spouseName) {    for (const pay of (crm.paymentRecords || [])) {      if (!pay.rawName) continue;      const slashMatch = pay.rawName.match(/^(.+?)\s*(?:Da\s*)?\/\s*(.+?)(?:\s*Di)?$/i);      if (slashMatch) {        const n1 = slashMatch[1].replace(/\s*Da\s*$/i, '').trim();        const n2 = slashMatch[2].replace(/\s*Di\s*$/i, '').trim();        const memberFirst = (crm.firstName || '').toLowerCase();        const spouse = n1.toLowerCase().includes(memberFirst) ? n2 : n1;        if (spouse && spouse.length > 1) { result.spouseName = spouse; result.confidence = 'medium'; result.allMembers.push({ name: spouse, relationship: 'spouse (from payment records)', email: null }); break; }      }    }  }  // 5. familyMembers (extended)  for (const fm of (crm.familyMembers || [])) {    if (!result.allMembers.some(x => x.email === fm.email || x.name === fm.displayName)) {      result.allMembers.push({ name: fm.displayName, relationship: 'family member', email: fm.email });    }  }  // Build family label  if (result.spouseName && crm.householdType === 'family') {    const kids = result.childrenCount;    result.familyLabel = `${crm.firstName} & ${result.spouseName.split(' ')[0]} ${crm.lastName} Family${kids > 0 ? ` (+${kids} child${kids > 1 ? 'ren' : ''})` : ''}`;  } else if (result.spouseName && crm.householdType === 'couple') {    result.familyLabel = `${crm.firstName} & ${result.spouseName.split(' ')[0]} ${crm.lastName}`;  } else {    result.familyLabel = crm.displayName || `${crm.firstName} ${crm.lastName}`;  }  return result;}/** * Get the correct FULL household membership amount for previous year. * CRM paymentRecords.amount sometimes stores per-person (halved) values. * householdMembershipAmount has the correct FULL household amount. */function getPreviousYearAmount(crm) {  const hhAmt = crm.householdMembershipAmount;  const prevPay = (crm.paymentRecords || []).find(p => p.year === '2025-26');  if (hhAmt && hhAmt > 0) return { amount: hhAmt, category: crm.householdMembershipCategory || 'Previous Plan', source: 'household_record' };  if (prevPay) {    const knownHalved = { 170: 340, 150: 300, 107.5: 215, 125: 250 };    return { amount: knownHalved[prevPay.amount] || prevPay.amount, category: prevPay.category, source: knownHalved[prevPay.amount] ? 'corrected_halved' : 'payment_record' };  }  return null;}// =====================================================// PRICE MATCHING// =====================================================function findPriceMatches(amount) {  const matches = [];  for (const [catId, cat] of Object.entries(CONFIG.PRICING)) {    for (const [tier, price] of Object.entries(cat)) {      if (tier === 'name' || tier === 'desc') continue;      if (price === amount) matches.push({ category: catId, categoryName: cat.name, tier, amount: price });    }  }  return matches;}function guessCategoryFromAmount(amount, householdType) {  const tier = householdType === 'family' ? 'family' : householdType === 'couple' ? 'couple' : 'individual';  for (const [catId, cat] of Object.entries(CONFIG.PRICING)) { if (cat[tier] === amount) return catId; }  for (const [catId, cat] of Object.entries(CONFIG.PRICING)) { for (const [t, p] of Object.entries(cat)) { if (t !== 'name' && t !== 'desc' && p === amount) return catId; } }  return null;}// =====================================================// CRM ΓÇö ADMIN EDIT AS BENCHMARK OF TRUTH// =====================================================export async function getCRMRecord(email) {  try {    const res = await wixData.query(CONFIG.CRM_COLLECTION).eq('email', email).find({ suppressAuth: true });    return res.items.length > 0 ? res.items[0] : null;  } catch (e) { return null; }}export async function getAllCRMRecords(filters = {}) {  try {    let query = wixData.query(CONFIG.CRM_COLLECTION).limit(500);    if (filters.status) query = query.eq('pipelineStatus', filters.status);    if (filters.paymentStatus) query = query.eq('paymentStatus', filters.paymentStatus);    if (filters.hasEviteYes) query = query.eq('eviteResponse', 'yes');    return (await query.find({ suppressAuth: true })).items;  } catch (e) { return []; }}export async function adminUpdateCRM(email, changes, reason) {  const admin = await requireAdmin();  let record = await getCRMRecord(email);  if (!record) throw new Error(`CRM record not found for ${email}`);  const changeLog = {};  for (const [field, newValue] of Object.entries(changes)) { changeLog[field] = { old: record[field], new: newValue }; record[field] = newValue; }  record.lastModifiedBy = admin.email; record.lastModifiedAt = new Date(); record.lastModifiedSource = 'admin_manual';  await wixData.update(CONFIG.CRM_COLLECTION, record, { suppressAuth: true });  const memberSyncFields = ['firstName','lastName','displayName','phone','address','city','state','zip','householdType','membershipCategory','membershipTier','membershipAmount','paymentStatus'];  const memberChanges = {}; for (const f of memberSyncFields) { if (changes[f] !== undefined) memberChanges[f] = changes[f]; }  if (Object.keys(memberChanges).length > 0) await syncToMembersCollection(email, memberChanges);  const paymentFields = ['paymentAmount','paymentStatus','membershipCategory','membershipTier'];  const affectsPipeline = paymentFields.some(f => changes[f] !== undefined);  if (affectsPipeline) await reevaluatePipeline(email, changes);  await audit('admin_crm_update', admin.email, email, { changes: changeLog, reason: reason || 'Admin manual correction', affectsPipeline });  return { success: true, email, changes: changeLog, affectsPipeline };}export async function adminBulkUpdateCRM(updates) {  const admin = await requireAdmin();  const results = [];  for (const { email, changes, reason } of updates) { try { results.push(await adminUpdateCRM(email, changes, reason)); } catch (e) { results.push({ success: false, email, error: e.message }); } }  return { total: updates.length, succeeded: results.filter(r => r.success).length, results };}async function syncToMembersCollection(email, changes) {  try {    const res = await wixData.query(CONFIG.MEMBERS_COLLECTION).eq('email', email).find({ suppressAuth: true });    if (res.items.length > 0) { const member = { ...res.items[0], ...changes, updatedAt: new Date() }; await wixData.update(CONFIG.MEMBERS_COLLECTION, member, { suppressAuth: true }); }  } catch (e) { console.error(`syncToMembersCollection failed for ${email}:`, e); }}async function reevaluatePipeline(email, changes) {  try {    const pipeline = await wixData.query(CONFIG.PIPELINE_COLLECTION).eq('email', email).find({ suppressAuth: true });    if (pipeline.items.length === 0) return;    const record = pipeline.items[0];    if (changes.paymentAmount !== undefined) {      const matches = findPriceMatches(changes.paymentAmount);      record.stages.payment_match = { status: matches.length > 0 ? 'completed' : 'needs_review', matches, source: 'admin_correction', updatedAt: new Date().toISOString() };    }    if (changes.paymentStatus === 'paid') {      record.stages.payment = { status: 'completed', source: 'admin_confirmed', updatedAt: new Date().toISOString() };      if (record.stages.drive_signup?.status !== 'completed') record.stages.drive_signup = { status: 'pending', source: 'auto_advanced', updatedAt: new Date().toISOString() };    }    if (changes.membershipCategory || changes.membershipTier) {      record.stages.membership_rec = { status: 'completed', category: changes.membershipCategory || record.membershipCategory, tier: changes.membershipTier || record.membershipTier, source: 'admin_override', updatedAt: new Date().toISOString() };    }    record.lastUpdated = new Date();    await wixData.update(CONFIG.PIPELINE_COLLECTION, record, { suppressAuth: true });  } catch (e) { console.error(`reevaluatePipeline failed for ${email}:`, e); }}// =====================================================// PIPELINE MANAGEMENT// =====================================================export async function getPipelineStatus(email) {  try { const res = await wixData.query(CONFIG.PIPELINE_COLLECTION).eq('email', email).find({ suppressAuth: true }); return res.items.length > 0 ? res.items[0] : null; } catch (e) { return null; }}export async function getAllPipelineRecords() {  try { return (await wixData.query(CONFIG.PIPELINE_COLLECTION).limit(500).find({ suppressAuth: true })).items; } catch (e) { return []; }}export async function initializePipeline(email, memberData) {  const admin = await requireAdmin();  const existing = await getPipelineStatus(email);  const family = detectFamily(memberData);  const prevYear = getPreviousYearAmount(memberData);  const record = {    email, displayName: memberData.displayName || '', householdType: memberData.householdType || 'individual',    eviteResponse: memberData.eviteResponse || null, eviteAdults: memberData.eviteAdults || 0, eviteKids: memberData.eviteKids || 0,    paymentAmount: memberData.paymentAmount || 0, paymentSource: memberData.paymentSource || null, paymentSenderName: memberData.paymentSenderName || null,    membershipCategory: memberData.membershipCategory || null, membershipTier: memberData.membershipTier || null,    family, previousYear: prevYear,    stages: {}, pipelineStatus: 'initialized', createdBy: admin.email, createdAt: new Date(), lastUpdated: new Date()  };  CONFIG.STAGES.forEach(s => { record.stages[s] = { status: 'not_started', updatedAt: new Date().toISOString() }; });  if (existing) { record._id = existing._id; await wixData.update(CONFIG.PIPELINE_COLLECTION, record, { suppressAuth: true }); }  else { await wixData.insert(CONFIG.PIPELINE_COLLECTION, record, { suppressAuth: true }); }  await audit('pipeline_initialized', admin.email, email, { memberData: { email: memberData.email, displayName: memberData.displayName } });  return record;}export async function advancePipelineStage(email, stageId, stageData) {  const admin = await requireAdmin();  const record = await getPipelineStatus(email);  if (!record) throw new Error(`No pipeline for ${email}`);  record.stages[stageId] = { ...record.stages[stageId], ...stageData, updatedAt: new Date().toISOString(), updatedBy: admin.email };  if (stageData.status === 'completed') {    const idx = CONFIG.STAGES.indexOf(stageId);    if (idx >= 0 && idx < CONFIG.STAGES.length - 1) { const ns = CONFIG.STAGES[idx + 1]; if (record.stages[ns]?.status === 'not_started') record.stages[ns].status = 'pending'; }  }  record.lastUpdated = new Date();  await wixData.update(CONFIG.PIPELINE_COLLECTION, record, { suppressAuth: true });  await audit('pipeline_stage_advanced', admin.email, email, { stageId, stageData });  return record;}// =====================================================// RUN FULL PIPELINE (v2 ΓÇö server-side)// =====================================================/** * Run the full pipeline for all active members (admin only). * This is the server-side equivalent of bosonto-pipeline-executor.js. * Reads CRM, processes each member, sends clean emails, returns results. */export async function runFullPipeline() {  const admin = await requireAdmin();  const settings = await getSystemSettings();  const crmRecords = await getAllCRMRecords();  const results = [];  const emailsSent = [];  await audit('pipeline_started', admin.email, null, { memberCount: crmRecords.length, testMode: settings.testMode });  for (const crm of crmRecords) {    if (!crm.email) continue;    const family = detectFamily(crm);    const prevYear = getPreviousYearAmount(crm);    const tier = crm.householdType === 'family' ? 'family' : crm.householdType === 'couple' ? 'couple' : 'individual';    const memberResult = { email: crm.email, displayName: crm.displayName, family, prevYear, emails: [] };    if (crm.paymentStatus === 'paid') {      // Send confirmation + verification      const confirmResult = await sendWorkflowEmail({        to: crm.email,        subject: `BANF ${CONFIG.MEMBERSHIP_YEAR} Membership Confirmed ΓÇö Welcome!`,        body_html: buildMembershipConfirmEmail(crm, family)      }, settings);      memberResult.emails.push({ type: 'membership_confirmation', ...confirmResult });      emailsSent.push(confirmResult);      const verifyResult = await sendWorkflowEmail({        to: crm.email,        subject: `BANF ${CONFIG.MEMBERSHIP_YEAR} ΓÇö Please Verify Your Details`,        body_html: buildContactVerifyEmail(crm, family)      }, settings);      memberResult.emails.push({ type: 'contact_verification', ...verifyResult });      emailsSent.push(verifyResult);    } else if (crm.eviteResponse === 'yes') {      // Send payment reminder      const reminderResult = await sendWorkflowEmail({        to: crm.email,        subject: `BANF Bosonto Utsob 2026 ΓÇö Complete Your Membership`,        body_html: buildPaymentReminderEmail(crm, family, prevYear, tier)      }, settings);      memberResult.emails.push({ type: 'payment_reminder', ...reminderResult });      emailsSent.push(reminderResult);    }    results.push(memberResult);  }  await audit('pipeline_completed', admin.email, null, { totalMembers: results.length, emailsSent: emailsSent.length, testMode: settings.testMode });  return { totalMembers: results.length, emailsSent: emailsSent.length, testMode: settings.testMode, results };}// =====================================================// BATCH PROCESSING// =====================================================export async function queueBatchProcessing(memberEmails, processingType) {  const admin = await requireAdmin();  const batch = await wixData.insert(CONFIG.BATCH_COLLECTION, {    batchId: `BATCH-${Date.now()}`, memberEmails, processingType,    totalCount: memberEmails.length, processedCount: 0, status: 'queued',    queuedBy: admin.email, queuedAt: new Date(), results: []  }, { suppressAuth: true });  await audit('batch_queued', admin.email, null, { batchId: batch.batchId, count: memberEmails.length, type: processingType });  return batch;}export async function approveBatch(batchId) {  const admin = await requireAdmin();  const settings = await getSystemSettings();  if (!settings.batchMode) throw new Error('Batch processing is not enabled. Call enableBatchProcessing() first.');  const res = await wixData.query(CONFIG.BATCH_COLLECTION).eq('batchId', batchId).find({ suppressAuth: true });  if (res.items.length === 0) throw new Error(`Batch ${batchId} not found`);  const batch = res.items[0];  batch.status = 'approved'; batch.approvedBy = admin.email; batch.approvedAt = new Date();  await wixData.update(CONFIG.BATCH_COLLECTION, batch, { suppressAuth: true });  await audit('batch_approved', admin.email, null, { batchId });  processBatch(batch).catch(e => console.error('Batch error:', e));  return { batchId, status: 'approved', message: 'Processing started' };}async function processBatch(batch) {  const settings = await getSystemSettings();  try {    batch.status = 'processing';    await wixData.update(CONFIG.BATCH_COLLECTION, batch, { suppressAuth: true });    for (const email of batch.memberEmails) {      const currentSettings = await getSystemSettings();      if (!currentSettings.batchMode) { batch.status = 'paused'; await wixData.update(CONFIG.BATCH_COLLECTION, batch, { suppressAuth: true }); return; }      try { const result = await processOneMember(email, batch.processingType, settings); batch.results.push({ email, status: 'success', result }); }      catch (e) { batch.results.push({ email, status: 'failed', error: e.message }); }      batch.processedCount++; await wixData.update(CONFIG.BATCH_COLLECTION, batch, { suppressAuth: true });    }    batch.status = 'completed'; batch.completedAt = new Date();    await wixData.update(CONFIG.BATCH_COLLECTION, batch, { suppressAuth: true });  } catch (e) { batch.status = 'failed'; batch.error = e.message; await wixData.update(CONFIG.BATCH_COLLECTION, batch, { suppressAuth: true }); }}async function processOneMember(email, processingType, settings) {  const crm = await getCRMRecord(email);  if (!crm) throw new Error(`No CRM record for ${email}`);  const family = detectFamily(crm);  const prevYear = getPreviousYearAmount(crm);  const tier = crm.householdType === 'family' ? 'family' : crm.householdType === 'couple' ? 'couple' : 'individual';  const results = {};  switch (processingType) {    case 'payment_confirmation':      results.email = await sendWorkflowEmail({ to: crm.email, subject: `BANF ${CONFIG.MEMBERSHIP_YEAR} Membership Confirmed ΓÇö Welcome!`, body_html: buildMembershipConfirmEmail(crm, family) }, settings);      break;    case 'comm_verification':      results.email = await sendWorkflowEmail({ to: crm.email, subject: `BANF ${CONFIG.MEMBERSHIP_YEAR} ΓÇö Please Verify Your Details`, body_html: buildContactVerifyEmail(crm, family) }, settings);      break;    case 'payment_reminder':      results.email = await sendWorkflowEmail({ to: crm.email, subject: `BANF Bosonto Utsob 2026 ΓÇö Complete Your Membership`, body_html: buildPaymentReminderEmail(crm, family, prevYear, tier) }, settings);      break;    case 'onboarding':      results.confirm = await sendWorkflowEmail({ to: crm.email, subject: `BANF ${CONFIG.MEMBERSHIP_YEAR} Membership Confirmed ΓÇö Welcome!`, body_html: buildMembershipConfirmEmail(crm, family) }, settings);      results.verify = await sendWorkflowEmail({ to: crm.email, subject: `BANF ${CONFIG.MEMBERSHIP_YEAR} ΓÇö Please Verify Your Details`, body_html: buildContactVerifyEmail(crm, family) }, settings);      break;    case 'full_pipeline':      const pipeline = await getPipelineStatus(email);      if (pipeline) { for (const stage of CONFIG.STAGES) { if (pipeline.stages[stage]?.status === 'pending') results[stage] = { status: 'processed' }; } }      break;  }  return results;}// =====================================================// EMAIL SENDING ΓÇö TEST MODE AWARE// =====================================================async function sendWorkflowEmail(emailData, settings) {  const isTest = settings?.testMode !== false;  const actualTo = isTest ? CONFIG.TEST_EMAIL : emailData.to;  const subjectPrefix = isTest ? `[TEST ΓåÆ ${emailData.to}] ` : '';  const result = await sendEmail({    to: actualTo,    subject: `${subjectPrefix}${emailData.subject}`,    body_html: emailData.body_html || emailData.body,    reply_to: emailData.reply_to || CONFIG.BANF_EMAIL  });  await wixData.insert(CONFIG.SENT_EMAILS_COLLECTION, {    to: actualTo, originalTo: emailData.to, subject: `${subjectPrefix}${emailData.subject}`,    type: emailData.type || 'workflow', testMode: isTest, sentAt: new Date(),    status: result?.success ? 'sent' : 'failed'  }, { suppressAuth: true });  return { sent: true, testMode: isTest, recipient: actualTo, originalRecipient: emailData.to };}// =====================================================// EMAIL TEMPLATES v2.0 ΓÇö Clean, member-facing, always verify// =====================================================function esc(s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }function capitalize(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : ''; }/** * Membership Confirmation ΓÇö sent to paid members * Clean, no agent info, shows family with verify prompts */function buildMembershipConfirmEmail(crm, family) {  const cat = CONFIG.PRICING[crm.membershipCategory] || {};  const tier = crm.householdType === 'family' ? 'family' : crm.householdType === 'couple' ? 'couple' : 'individual';  const spouseRow = family.spouseName    ? `<tr><td style="padding:8px 14px;border-bottom:1px solid #eee;color:#555">Spouse</td>       <td style="padding:8px 14px;border-bottom:1px solid #eee">${esc(family.spouseName)}${family.confidence !== 'confirmed' ? ' <em style="color:#b71c1c;font-size:.85em">ΓÇö please verify</em>' : ''}</td></tr>` : '';  const kidsRow = family.childrenCount > 0    ? `<tr><td style="padding:8px 14px;border-bottom:1px solid #eee;color:#555">Children</td>       <td style="padding:8px 14px;border-bottom:1px solid #eee">${family.childrenCount} <em style="color:#b71c1c;font-size:.85em">ΓÇö please verify names/ages</em></td></tr>` : '';  return `<div style="font-family:'Segoe UI',Arial,sans-serif;max-width:620px;margin:0 auto;background:#fff">  <div style="background:linear-gradient(135deg,#8B0000,#b71c1c);color:#fff;padding:20px 24px;border-radius:10px 10px 0 0">    <h2 style="margin:0;font-size:1.3rem">≡ƒÄë Welcome to BANF ${CONFIG.MEMBERSHIP_YEAR}!</h2>    <p style="margin:6px 0 0;opacity:.9;font-size:.9rem">Your membership is confirmed</p>  </div>  <div style="padding:20px 24px;border:1px solid #e0e0e0;border-top:none;border-radius:0 0 10px 10px">    <p>Dear <strong>${esc(crm.firstName || crm.displayName)}</strong>,</p>    <p>Thank you for your payment! Your BANF membership for <strong>${CONFIG.MEMBERSHIP_YEAR}</strong> is confirmed.</p>    <table style="width:100%;border-collapse:collapse;margin:16px 0;background:#fafafa;border-radius:8px;overflow:hidden">      <tr><td style="padding:10px 14px;border-bottom:1px solid #eee;color:#555;width:38%">Membership</td>          <td style="padding:10px 14px;border-bottom:1px solid #eee"><strong>${cat.name || 'BANF Membership'}</strong></td></tr>      <tr><td style="padding:10px 14px;border-bottom:1px solid #eee;color:#555">Tier</td>          <td style="padding:10px 14px;border-bottom:1px solid #eee"><strong>${capitalize(tier)}</strong></td></tr>      <tr><td style="padding:10px 14px;border-bottom:1px solid #eee;color:#555">Amount Paid</td>          <td style="padding:10px 14px;border-bottom:1px solid #eee;color:#2e7d32;font-weight:700">$${crm.paymentAmount || 0}.00</td></tr>      ${spouseRow}      ${kidsRow}      <tr><td style="padding:10px 14px;color:#555">Season</td>          <td style="padding:10px 14px"><strong>${CONFIG.MEMBERSHIP_YEAR}</strong></td></tr>    </table>    ${cat.desc ? `<p style="color:#555;font-size:.88rem"><strong>Includes:</strong> ${cat.desc}</p>` : ''}    <div style="background:#e8f5e9;border:1px solid #c8e6c9;border-radius:8px;padding:14px;margin:16px 0">      <strong>≡ƒôà Upcoming:</strong> ${CONFIG.EVENT_NAME} ΓÇö <strong>${CONFIG.EVENT_DATE}</strong>    </div>    <div style="background:#fff8e1;border:1px solid #ffecb3;border-radius:8px;padding:14px;margin:16px 0">      <strong>ΓÜá∩╕Å Please verify:</strong> If any information above is incorrect ΓÇö your name, membership tier, family members, or payment amount ΓÇö please reply to this email with corrections.    </div>    <p style="color:#777;font-size:.82rem;margin-top:20px;border-top:1px solid #eee;padding-top:12px">      Questions? Reply to this email.<br>      Bengali Association of North Florida (BANF) | ${CONFIG.BANF_EMAIL}    </p>  </div></div>`;}/** * Contact Verification ΓÇö asks for missing phone/address, confirms spouse */function buildContactVerifyEmail(crm, family) {  return `<div style="font-family:'Segoe UI',Arial,sans-serif;max-width:620px;margin:0 auto;background:#fff">  <div style="background:linear-gradient(135deg,#1565c0,#1976d2);color:#fff;padding:20px 24px;border-radius:10px 10px 0 0">    <h2 style="margin:0;font-size:1.2rem">≡ƒôï Please Verify Your Contact Details</h2>    <p style="margin:6px 0 0;opacity:.9;font-size:.85rem">BANF ${CONFIG.MEMBERSHIP_YEAR}</p>  </div>  <div style="padding:20px 24px;border:1px solid #e0e0e0;border-top:none;border-radius:0 0 10px 10px">    <p>Dear <strong>${esc(crm.firstName || crm.displayName)}</strong>,</p>    <p>To make sure you receive all BANF communications and event updates, please review the details we have on file:</p>    <table style="width:100%;border-collapse:collapse;margin:16px 0;background:#fafafa;border-radius:8px;overflow:hidden">      <tr><td style="padding:8px 14px;border-bottom:1px solid #eee;color:#555;width:35%">Name</td>          <td style="padding:8px 14px;border-bottom:1px solid #eee">${esc(crm.displayName || `${crm.firstName} ${crm.lastName}`)}</td></tr>      <tr><td style="padding:8px 14px;border-bottom:1px solid #eee;color:#555">Email</td>          <td style="padding:8px 14px;border-bottom:1px solid #eee">${esc(crm.email)}</td></tr>      <tr><td style="padding:8px 14px;border-bottom:1px solid #eee;color:#555">Phone</td>          <td style="padding:8px 14px;border-bottom:1px solid #eee">${crm.phone ? esc(crm.phone) : '<span style="color:#d32f2f"><strong>Missing</strong> ΓÇö please provide</span>'}</td></tr>      <tr><td style="padding:8px 14px;border-bottom:1px solid #eee;color:#555">Address</td>          <td style="padding:8px 14px;border-bottom:1px solid #eee">${crm.address ? `${esc(crm.address)}, ${esc(crm.city || '')}, ${esc(crm.state || '')} ${esc(crm.zip || '')}` : '<span style="color:#d32f2f"><strong>Missing</strong> ΓÇö please provide</span>'}</td></tr>      <tr><td style="padding:8px 14px;border-bottom:1px solid #eee;color:#555">Membership</td>          <td style="padding:8px 14px;border-bottom:1px solid #eee">${capitalize(crm.householdType || 'individual')}</td></tr>      ${family.spouseName ? `<tr><td style="padding:8px 14px;border-bottom:1px solid #eee;color:#555">Spouse</td>          <td style="padding:8px 14px;border-bottom:1px solid #eee">${esc(family.spouseName)}${family.confidence !== 'confirmed' ? ' <em style="color:#b71c1c;font-size:.85em">ΓÇö is this correct?</em>' : ''}</td></tr>` : ''}      ${family.childrenCount > 0 ? `<tr><td style="padding:8px 14px;border-bottom:1px solid #eee;color:#555">Children</td>          <td style="padding:8px 14px;border-bottom:1px solid #eee">${family.childrenCount} <em style="color:#b71c1c;font-size:.85em">ΓÇö please confirm names and ages</em></td></tr>` : ''}    </table>    <div style="background:#fff8e1;border:1px solid #ffecb3;border-radius:8px;padding:14px;margin:16px 0">      <strong>ΓÜá∩╕Å Please reply with:</strong>      <ul style="margin:8px 0 0;padding-left:18px">        ${!crm.phone ? '<li>Your current <strong>phone number</strong></li>' : ''}        ${!crm.address ? '<li>Your current <strong>mailing address</strong></li>' : ''}        <li>Any corrections to the information above</li>        ${family.spouseName && family.confidence !== 'confirmed' ? '<li>Confirm your <strong>spouse/partner name</strong></li>' : ''}        ${family.childrenCount > 0 ? `<li><strong>Children's names and ages</strong></li>` : ''}      </ul>    </div>    <p style="color:#555;font-size:.88rem">If everything looks correct, a quick "confirmed" reply is appreciated!</p>    <p style="color:#777;font-size:.82rem;margin-top:20px;border-top:1px solid #eee;padding-top:12px">      Bengali Association of North Florida (BANF) | ${CONFIG.BANF_EMAIL}    </p>  </div></div>`;}/** * Payment Reminder ΓÇö sent to Evite-Yes unpaid members * Uses CORRECT full household amounts (not halved) */function buildPaymentReminderEmail(crm, family, prevYear, tier) {  const pricingRows = Object.entries(CONFIG.PRICING).filter(([k]) => k !== 'guest').map(([catId, cat]) => {    const price = cat[tier];    const isRec = catId === 'm2_eb';    return `<tr style="${isRec ? 'background:#e8f5e9;font-weight:600' : ''}">      <td style="padding:8px 14px;border-bottom:1px solid #eee">${isRec ? 'Γ¡É ' : ''}${cat.name}</td>      <td style="padding:8px 14px;border-bottom:1px solid #eee;text-align:right;font-weight:700;color:${isRec ? '#2e7d32' : '#333'}">$${price}</td>      <td style="padding:8px 14px;border-bottom:1px solid #eee;font-size:.8rem;color:#777">${cat.desc}</td>    </tr>`;  }).join('');  const prevContext = prevYear    ? `<p style="color:#555;font-size:.88rem">Last year your household was on the <strong>${prevYear.category}</strong> plan at <strong>$${prevYear.amount}</strong> (${capitalize(tier)}). Here are the options for the new season:</p>` : '';  const familyGreeting = family.spouseName    ? `Dear <strong>${esc(crm.firstName || crm.displayName)}</strong> & <strong>${esc(family.spouseName.split(' ')[0])}</strong>,`    : `Dear <strong>${esc(crm.firstName || crm.displayName)}</strong>,`;  return `<div style="font-family:'Segoe UI',Arial,sans-serif;max-width:620px;margin:0 auto;background:#fff">  <div style="background:linear-gradient(135deg,#e65100,#f57c00);color:#fff;padding:20px 24px;border-radius:10px 10px 0 0">    <h2 style="margin:0;font-size:1.2rem">≡ƒî╕ Bosonto Utsob 2026 ΓÇö Complete Your Membership</h2>    <p style="margin:6px 0 0;opacity:.9;font-size:.85rem">${CONFIG.EVENT_DATE}</p>  </div>  <div style="padding:20px 24px;border:1px solid #e0e0e0;border-top:none;border-radius:0 0 10px 10px">    <p>${familyGreeting}</p>    <p>Thank you for your RSVP to <strong>Bosonto Utsob 2026</strong>${crm.eviteAdults > 0 ? ` (${crm.eviteAdults} adult${crm.eviteAdults > 1 ? 's' : ''}${crm.eviteKids > 0 ? `, ${crm.eviteKids} child${crm.eviteKids > 1 ? 'ren' : ''}` : ''})` : ''}! We're looking forward to having ${family.spouseName ? 'your family' : 'you'} there.</p>    <p>To confirm your attendance, please complete your BANF membership payment for the ${CONFIG.MEMBERSHIP_YEAR} season:</p>    ${prevContext}    <table style="width:100%;border-collapse:collapse;margin:16px 0;border:1px solid #eee;border-radius:8px;overflow:hidden">      <thead><tr style="background:#f5f5f5">        <th style="padding:10px 14px;text-align:left;font-size:.82rem">Membership</th>        <th style="padding:10px 14px;text-align:right;font-size:.82rem">Price (${capitalize(tier)})</th>        <th style="padding:10px 14px;text-align:left;font-size:.82rem">Includes</th>      </tr></thead>      <tbody>${pricingRows}</tbody>    </table>    <div style="background:#e8eaf6;border:1px solid #c5cae9;border-radius:8px;padding:16px;margin:16px 0">      <strong>≡ƒÆ│ How to Pay:</strong>      <ul style="margin:8px 0 0;padding-left:18px">        <li>Send via <strong>Zelle</strong> to: <strong>${CONFIG.ZELLE_EMAIL}</strong></li>        <li>Memo: <strong>"BANF Membership ΓÇö ${crm.firstName || ''} ${crm.lastName || ''}"</strong></li>      </ul>      <p style="margin:8px 0 0;font-size:.9rem"><strong>Payment deadline:</strong> ${CONFIG.PAYMENT_DEADLINE}</p>    </div>    <div style="background:#fff8e1;border:1px solid #ffecb3;border-radius:8px;padding:14px;margin:16px 0">      <strong>ΓÜá∩╕Å Please verify and note:</strong>      <ul style="margin:8px 0 0;padding-left:18px">        ${family.spouseName && family.confidence !== 'confirmed' ? `<li>We have <strong>${esc(family.spouseName)}</strong> as your spouse ΓÇö <strong>please verify this is correct</strong></li>` : ''}        ${family.childrenCount > 0 ? `<li>We have <strong>${family.childrenCount} child(ren)</strong> on file ΓÇö please verify and share names/ages</li>` : ''}        <li>If you've already sent payment, please disregard ΓÇö we may not have matched it yet</li>        <li>Reply with any questions or if you need to verify or correct any details</li>      </ul>    </div>    <p style="color:#777;font-size:.82rem;margin-top:20px;border-top:1px solid #eee;padding-top:12px">      Bengali Association of North Florida (BANF) | ${CONFIG.BANF_EMAIL}    </p>  </div></div>`;}// =====================================================// CRM IMPORT// =====================================================export async function importCRMRecords(members) {  const admin = await requireAdmin();  const results = [];  for (const m of members) {    try {      const existing = await getCRMRecord(m.email);      const family = detectFamily(m);      const prevYear = getPreviousYearAmount(m);      const record = {        email: m.email, firstName: m.firstName || '', lastName: m.lastName || '',        displayName: m.displayName || `${m.firstName} ${m.lastName}`,        phone: m.phone || '', address: m.address || '', city: m.city || 'Jacksonville', state: m.state || 'FL', zip: m.zip || '',        householdType: m.householdType || 'individual', householdDisplayName: m.householdDisplayName || '',        eviteResponse: m.eviteResponse || null, eviteAdults: m.eviteAdults || 0, eviteKids: m.eviteKids || 0,        paymentAmount: m.paymentAmount || 0, paymentStatus: m.paymentStatus || 'unpaid',        paymentSource: m.paymentSource || null, paymentSenderName: m.paymentSenderName || null,        membershipCategory: m.membershipCategory || null, membershipTier: m.membershipTier || null, membershipYear: '2026-27',        isECMember: m.isECMember || false,        family, previousYear: prevYear,        pipelineStatus: m.pipelineStatus || 'new',        importedAt: new Date(), importedBy: admin.email, lastModifiedSource: 'import'      };      if (existing) { record._id = existing._id; await wixData.update(CONFIG.CRM_COLLECTION, record, { suppressAuth: true }); results.push({ email: m.email, status: 'updated' }); }      else { await wixData.insert(CONFIG.CRM_COLLECTION, record, { suppressAuth: true }); results.push({ email: m.email, status: 'created' }); }    } catch (e) { results.push({ email: m.email, status: 'failed', error: e.message }); }  }  await audit('crm_import', admin.email, null, { count: members.length, results: results.filter(r => r.status !== 'failed').length });  return { total: members.length, imported: results.filter(r => r.status !== 'failed').length, results };}// =====================================================// DASHBOARD DATA ENDPOINT// =====================================================/** * Returns all data needed by the client-side dashboard. * Called from the admin portal page code. */export async function getDashboardData() {  const admin = await requireAdmin();  const [crmRecords, pipelineRecords, settings, emails] = await Promise.all([    getAllCRMRecords(),    getAllPipelineRecords(),    getSystemSettings(),    wixData.query(CONFIG.SENT_EMAILS_COLLECTION).descending('sentAt').limit(50).find({ suppressAuth: true }).then(r => r.items).catch(() => [])  ]);  const paid = crmRecords.filter(r => r.paymentStatus === 'paid');  const unpaid = crmRecords.filter(r => r.eviteResponse === 'yes' && r.paymentStatus !== 'paid');  return {    config: { ...CONFIG, PRICING: CONFIG.PRICING, STAGES: CONFIG.STAGES },    settings,    summary: { total: crmRecords.length, paid: paid.length, unpaidYes: unpaid.length, totalCollected: paid.reduce((s, r) => s + (r.paymentAmount || 0), 0), emailsSent: emails.length, testMode: settings.testMode },    members: crmRecords.map(crm => ({      ...crm, family: detectFamily(crm), previousYear: getPreviousYearAmount(crm)    })),    pipeline: pipelineRecords,    recentEmails: emails  };}