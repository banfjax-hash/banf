{  "$schema": "langgraph/1.0",  "id": "banf_ec_onboarding_workflow",  "title": "BANF EC Onboarding Drive ΓÇö Full Workflow Graph",  "description": "LangGraph-style state machine for the EC member onboarding pipeline. Agents MUST follow this graph for all EC onboarding operations.",  "version": "1.0.0",  "created": "2026-03-05",  "state_schema": {    "email": { "type": "string", "description": "EC member's email address" },    "role": { "type": "string", "enum": ["ec_member", "admin", "super_admin"], "description": "Assigned admin role" },    "ecTitle": { "type": "string", "description": "EC position title (e.g., Treasurer, Vice President)" },    "setupToken": { "type": "string", "description": "One-time setup token from role assignment" },    "passwordSet": { "type": "boolean", "default": false },    "profileComplete": { "type": "boolean", "default": false },    "onboardComplete": { "type": "boolean", "default": false },    "inviteSent": { "type": "boolean", "default": false },    "congratsSent": { "type": "boolean", "default": false },    "reminderCount": { "type": "integer", "default": 0 },    "loginVerified": { "type": "boolean", "default": false },    "portalAccess": { "type": "string", "enum": ["none", "member-portal", "admin-portal"], "default": "none" },    "error": { "type": "string", "nullable": true }  },  "nodes": {    "START": {      "type": "entry",      "description": "Super admin initiates EC onboarding for a member",      "next": "assign_role"    },    "assign_role": {      "type": "action",      "description": "Super admin assigns EC role to a member email",      "api": "POST /admin_role_add",      "input": {        "email": "state.email",        "role": "ec_member",        "ecTitle": "state.ecTitle"      },      "output": {        "setupToken": "response.setupToken",        "onboardUrl": "response.onboardUrl"      },      "validations": [        "response.success === true",        "response.setupToken is non-empty string",        "response.onboardUrl contains 'banfjax-hash.github.io/banf/'"      ],      "on_success": "check_email_sent",      "on_error": "handle_error"    },    "check_email_sent": {      "type": "conditional",      "description": "EC role_add skips individual emails; invitations are batched via ec_send_all_invitations",      "condition": "response.emailSent === false && response.emailSkipped contains 'ec_send_all_invitations'",      "on_true": "batch_invitations",      "on_false": "wait_for_signup"    },    "batch_invitations": {      "type": "action",      "description": "Super admin triggers batch invitation emails to ALL pending EC members",      "api": "POST /ec_send_all_invitations",      "input": {},      "headers": { "x-user-email": "super_admin_email" },      "output": {        "sent": "response.sent (count)",        "failed": "response.failed (count)",        "results": "response.results (per-member details)"      },      "validations": [        "response.success === true",        "response.sent >= 1",        "response.failed === 0",        "each result has emailSubject (RFC 2047 encoded, no raw non-ASCII)"      ],      "email_details": {        "template": "buildInviteEmail()",        "encoding": "Content-Transfer-Encoding: base64",        "link": "ec-admin-login.html?signup=true&email={email}&expires={48h_ts}",        "subject": "BANF EC Onboarding Invitation ΓÇö {ecTitle}"      },      "on_success": "wait_for_signup",      "on_error": "handle_error"    },    "wait_for_signup": {      "type": "wait",      "description": "EC member receives email with signup link. Link opens ec-admin-login.html?signup=true with email pre-filled. Member completes 3-step signup. This is a human-in-the-loop node.",      "user_action": "Click email button ΓåÆ ec-admin-login.html ΓåÆ Begin Signup",      "timeout": "48 hours (link expiry)",      "on_timeout": "send_reminder",      "on_complete": "signup_direct"    },    "send_reminder": {      "type": "action",      "description": "Super admin sends reminder to members who haven't completed onboarding",      "api": "POST /ec_send_reminder",      "input": {},      "email_details": {        "template": "buildReminderEmail()",        "encoding": "Content-Transfer-Encoding: base64",        "link": "ec-admin-login.html?signup=true&email={email}&expires={48h_ts}",        "subject": "Reminder: BANF EC Onboarding ΓÇö {ecTitle}"      },      "on_success": "wait_for_signup",      "on_error": "handle_error"    },    "signup_direct": {      "type": "action",      "description": "EC member's email is validated against AdminRoles collection (no verification code needed)",      "api": "POST /admin_signup_direct",      "input": {        "email": "state.email"      },      "output": {        "setupToken": "response.setupToken",        "firstName": "response.firstName",        "lastName": "response.lastName",        "ecTitle": "response.ecTitle",        "role": "response.role"      },      "validations": [        "response.success === true",        "response.role === 'ec_member'",        "response.setupToken is non-empty"      ],      "on_success": "set_password",      "on_error": "handle_error"    },    "set_password": {      "type": "action",      "description": "EC member sets their password (min 8 chars). Token is required.",      "api": "POST /admin_set_password",      "input": {        "email": "state.email",        "token": "state.setupToken",        "password": "user_input (min 8 chars)"      },      "validations": [        "response.success === true"      ],      "state_update": { "passwordSet": true },      "on_success": "save_profile",      "on_error": "handle_error"    },    "save_profile": {      "type": "action",      "description": "EC member saves profile with security question and answer",      "api": "POST /admin_save_profile",      "input": {        "email": "state.email",        "token": "state.setupToken",        "phone": "N/A or user_input",        "securityQuestion": "user_selected_question",        "securityAnswer": "user_answer.toLowerCase()"      },      "validations": [        "response.success === true"      ],      "state_update": { "profileComplete": true },      "on_success": "onboard_complete",      "on_error": "handle_error"    },    "onboard_complete": {      "type": "action",      "description": "Mark onboarding as complete. Backend sets isOnboarded=true in AdminRoles collection.",      "api": "POST /admin_onboard_complete",      "input": {        "email": "state.email",        "token": "state.setupToken"      },      "output": {        "portalUrl": "response.portalUrl"      },      "validations": [        "response.success === true",        "response.portalUrl contains 'banfjax-hash.github.io/banf/'"      ],      "state_update": { "onboardComplete": true },      "on_success": "send_congratulations",      "on_error": "handle_error"    },    "send_congratulations": {      "type": "action",      "description": "Send congratulations email with portal links (fire-and-forget)",      "api": "POST /ec_signup_congratulations",      "input": {        "email": "state.email",        "firstName": "state.firstName",        "lastName": "state.lastName"      },      "email_details": {        "template": "buildCongratsEmail()",        "encoding": "Content-Transfer-Encoding: base64",        "links_table": [          { "label": "BANF Website", "url": "https://www.jaxbengali.org" },          { "label": "Member Login", "url": "member-login.html" },          { "label": "EC Admin Portal", "url": "admin-portal.html" },          { "label": "Requirements Journey", "url": "stakeholder-requirements-journey.html" }        ],        "subject": "Welcome to BANF EC ΓÇö {firstName}! Onboarding Complete"      },      "state_update": { "congratsSent": true },      "on_success": "verify_login",      "on_error": "verify_login"    },    "verify_login": {      "type": "action",      "description": "Verify the member can now log in with their new credentials",      "api": "POST /admin_verify_login",      "input": {        "email": "state.email",        "password": "state.password"      },      "validations": [        "response.success === true",        "response.adminRole === 'ec_member'",        "response.ecTitle === state.ecTitle"      ],      "state_update": { "loginVerified": true },      "on_success": "route_to_portal",      "on_error": "handle_error"    },    "route_to_portal": {      "type": "conditional",      "description": "Route user to the correct portal based on their role. EC members go to member-portal; super-admin/admin go to admin-portal.",      "routing_rules": [        { "condition": "role in ['super-admin', 'admin']", "target": "admin-portal.html", "portal": "admin-portal" },        { "condition": "role === 'ec-member' || role === 'ec_member'", "target": "member-portal.html", "portal": "member-portal" },        { "condition": "role === 'business-stakeholder'", "target": "admin-portal.html", "portal": "admin-portal" }      ],      "session_storage": {        "banf_admin_session": {          "email": "state.email",          "name": "state.name",          "roles": ["state.role"],          "effectiveRole": "state.role",          "ecTitle": "state.ecTitle",          "source": "ec-admin-login"        },        "banf_member_data": {          "name": "state.name",          "email": "state.email",          "membershipType": "EC Member",          "isECMember": true,          "role": "state.ecTitle"        }      },      "state_update": { "portalAccess": "member-portal" },      "on_complete": "verify_db_state"    },    "verify_db_state": {      "type": "action",      "description": "Final verification: check AdminRoles collection for correct state",      "api": "POST /admin_roles",      "validations": [        "record exists for state.email",        "record.role === 'ec_member'",        "record.isActive === true",        "record.ecTitle === state.ecTitle",        "record.isOnboarded === true"      ],      "on_success": "END_SUCCESS",      "on_error": "handle_error"    },    "handle_error": {      "type": "error_handler",      "description": "Log error, update state, determine retry or escalate",      "actions": [        "Log error with timestamp and context",        "If retryable (network/timeout): retry with exponential backoff",        "If auth error (403): verify super_admin credentials",        "If data error (400): validate input and retry",        "If persistent: escalate to super_admin"      ],      "next": "END_ERROR"    },    "END_SUCCESS": {      "type": "terminal",      "description": "EC member fully onboarded. Member can access member-portal.html with EC badge. Admin functions accessible via admin-portal.html link.",      "postconditions": [        "AdminRoles collection: isActive=true, isOnboarded=true",        "Member can login at member-login.html with EC email + password",        "Member sees EC badge and EC Admin link on member portal",        "Congratulations email delivered with portal links",        "GitHub Actions CI/CD remains green"      ]    },    "END_ERROR": {      "type": "terminal",      "description": "Onboarding failed ΓÇö manual intervention required",      "escalation": "Contact super_admin at banfjax@gmail.com"    }  },  "edges": [    { "from": "START", "to": "assign_role" },    { "from": "assign_role", "to": "check_email_sent" },    { "from": "check_email_sent", "to": "batch_invitations", "label": "email not sent (batched)" },    { "from": "check_email_sent", "to": "wait_for_signup", "label": "email already sent" },    { "from": "batch_invitations", "to": "wait_for_signup" },    { "from": "wait_for_signup", "to": "signup_direct", "label": "member clicks signup link" },    { "from": "wait_for_signup", "to": "send_reminder", "label": "timeout (48h)" },    { "from": "send_reminder", "to": "wait_for_signup" },    { "from": "signup_direct", "to": "set_password" },    { "from": "set_password", "to": "save_profile" },    { "from": "save_profile", "to": "onboard_complete" },    { "from": "onboard_complete", "to": "send_congratulations" },    { "from": "send_congratulations", "to": "verify_login" },    { "from": "verify_login", "to": "route_to_portal" },    { "from": "route_to_portal", "to": "verify_db_state" },    { "from": "verify_db_state", "to": "END_SUCCESS" },    { "from": "assign_role", "to": "handle_error", "label": "error" },    { "from": "batch_invitations", "to": "handle_error", "label": "error" },    { "from": "signup_direct", "to": "handle_error", "label": "error" },    { "from": "set_password", "to": "handle_error", "label": "error" },    { "from": "save_profile", "to": "handle_error", "label": "error" },    { "from": "onboard_complete", "to": "handle_error", "label": "error" },    { "from": "verify_login", "to": "handle_error", "label": "error" },    { "from": "verify_db_state", "to": "handle_error", "label": "error" },    { "from": "handle_error", "to": "END_ERROR" }  ],  "frontend_pages": {    "ec-admin-login.html": {      "purpose": "EC member signup + login portal",      "url_params": "?signup=true&email={email}&expires={timestamp}",      "signup_flow": ["signupStep1() ΓåÆ admin_signup_direct", "signupStep2Submit() ΓåÆ admin_set_password + admin_save_profile + admin_onboard_complete", "Step 3: success ΓåÆ Sign In"],      "login_flow": ["enterPortal() ΓåÆ set banf_admin_session + banf_member_data", "EC members ΓåÆ member-portal.html", "Super admin/admin ΓåÆ admin-portal.html"],      "auto_login": "DOMContentLoaded checks banf_admin_session ΓåÆ routes by role"    },    "member-login.html": {      "purpose": "General member login (EC + future regular members)",      "ec_path": "EC_ROSTER match ΓåÆ password check ΓåÆ member-portal.html",      "non_ec_path": "API /member_profile ΓåÆ member-portal.html",      "session_keys": ["banf_member_data", "banf_admin_session (for EC members)"]    },    "admin-login.html": {      "purpose": "Super admin + stakeholder login ONLY",      "role_gate": "Blocks ec_member ΓÇö directs them to ec-admin-login.html",      "redirect": "admin-portal.html"    },    "member-portal.html": {      "purpose": "Member services portal ΓÇö EC members see badge + EC Admin link",      "auth_gate": "Requires banf_member_data in sessionStorage",      "ec_features": "Gold EC badge, EC Admin portal link"    },    "admin-portal.html": {      "purpose": "Admin/EC management portal ΓÇö role-gated sidebar",      "title_dynamic": "Updates to 'EC Admin Portal' / 'Super Admin Portal' / 'Stakeholder Portal' based on role",      "sidebar_gating": "data-roles attribute on each item",      "roles": {        "super_admin": "Full system access ΓÇö all panels",        "admin": "Operational ΓÇö EC Drive, Stakeholder, some system panels",        "ec_member": "EC Drive + Drive Status only",        "business_stakeholder": "Stakeholder Drive + Feedback only"      }    }  },  "backend_apis": {    "base_url": "https://www.jaxbengali.org/_functions",    "auth_header": "x-user-email",    "module": "ec-onboarding-gate.js (1015 lines)",    "encoding": {      "email_body": "Content-Transfer-Encoding: base64 (NOT quoted-printable)",      "subject": "RFC 2047 B-encoding via mimeEncodeHeader()",      "gmail_raw": "base64url (btoa ΓåÆ replace +/-/= for web-safe)"    },    "test_mode": {      "flag": "TEST_MODE = true (line 40)",      "behavior": "All emails redirect to PRESIDENT_EMAIL (ranadhir.ghosh@gmail.com)",      "production": "Set TEST_MODE = false before members drive launch"    }  },  "deploy_targets": {    "frontend": {      "host": "banfjax-hash.github.io/banf/",      "deploy": "git push ΓåÆ GitHub Pages auto-deploy",      "ci": "GitHub Actions: BANF E2E Pipeline Tests + pages build"    },    "backend": {      "host": "www.jaxbengali.org (Wix)",      "deploy": "cd banf-wix-linked && npx wix publish",      "note": "Interactive prompts ΓÇö use auto-wix-publish.js for automation"    }  },  "agent_instructions": {    "before_any_change": [      "1. Read this workflow graph to understand the full pipeline",      "2. Identify which node(s) your change affects",      "3. Run the E2E test: node banf-pipeline-test-agent.js --ec-only",      "4. Verify CI is green after push"    ],    "email_changes": [      "NEVER use Content-Transfer-Encoding: quoted-printable",      "ALWAYS use base64 for email body encoding",      "All non-ASCII in templates MUST be HTML entities (&#x...;)",      "Test with: node test-email-encoding.js"    ],    "redirect_rules": [      "ec_member role ΓåÆ member-portal.html (NOT admin-portal.html)",      "super-admin role ΓåÆ admin-portal.html",      "admin role ΓåÆ admin-portal.html",      "business-stakeholder role ΓåÆ admin-portal.html"    ],    "session_keys": {      "banf_admin_session": "Set by all login pages; contains roles[], effectiveRole, ecTitle",      "banf_member_data": "Set for member portal; contains isECMember, role, membershipType",      "banf_ec_creds_{email}": "localStorage ΓÇö cross-portal password cache (set during signup)"    }  }}