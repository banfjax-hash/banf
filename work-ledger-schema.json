{  "$schema": "https://json-schema.org/draft/2020-12/schema",  "title": "BANF Agentic Platform ΓÇö Collection Schemas",  "description": "Wix collection definitions for the 6 new platform collections",  "version": "1.0.0",  "collections": {    "WorkLedger": {      "displayName": "Work Ledger",      "permissions": { "read": "Admin", "create": "Admin", "update": "Admin", "delete": "Admin" },      "fields": {        "workItemId":    { "type": "text",      "required": true,  "description": "Unique work item ID (e.g. REQ-001, STY-042)" },        "type":          { "type": "text",      "required": true,  "description": "epic | story | task | bug | spike" },        "status":        { "type": "text",      "required": true,  "description": "backlog | in_progress | review | done | blocked" },        "priority":      { "type": "text",      "required": true,  "description": "P0 | P1 | P2 | P3" },        "title":         { "type": "text",      "required": true,  "description": "Human-readable title" },        "description":   { "type": "text",      "required": false, "description": "Full description / acceptance criteria" },        "assignee":      { "type": "text",      "required": false, "description": "Assigned developer / agent" },        "ownerAgent":    { "type": "text",      "required": true,  "description": "Agent ID that currently owns this item" },        "currentStage":  { "type": "text",      "required": true,  "description": "Current lifecycle stage: requirements | design | development | testing | deployment | operations" },        "parentId":      { "type": "text",      "required": false, "description": "Parent work item ID (epic for stories)" },        "traceLinks":    { "type": "text",      "required": false, "description": "JSON array of linked item IDs across lifecycle" },        "correlationId": { "type": "text",      "required": true,  "description": "Groups all events for one lifecycle flow" },        "sprintId":      { "type": "text",      "required": false, "description": "Sprint identifier" },        "storyPoints":   { "type": "number",    "required": false, "description": "Estimated effort" },        "createdAt":     { "type": "datetime",  "required": true,  "description": "Creation timestamp" },        "updatedAt":     { "type": "datetime",  "required": true,  "description": "Last update timestamp" }      }    },    "AgentEventLog": {      "displayName": "Agent Event Log",      "permissions": { "read": "Admin", "create": "Admin", "update": "Admin", "delete": "Admin" },      "fields": {        "eventId":       { "type": "text",      "required": true,  "description": "Unique event ID" },        "eventType":     { "type": "text",      "required": true,  "description": "Event type (e.g. requirement_created, code_merged)" },        "sourceAgent":   { "type": "text",      "required": true,  "description": "Agent that emitted the event" },        "targetAgent":   { "type": "text",      "required": false, "description": "Intended recipient agent (null = broadcast)" },        "workItemId":    { "type": "text",      "required": true,  "description": "Related work item" },        "correlationId": { "type": "text",      "required": true,  "description": "Lifecycle flow correlation" },        "payload":       { "type": "text",      "required": false, "description": "JSON payload with event-specific data" },        "status":        { "type": "text",      "required": true,  "description": "pending | processing | completed | failed" },        "retryCount":    { "type": "number",    "required": false, "description": "Number of processing attempts" },        "createdAt":     { "type": "datetime",  "required": true,  "description": "Event timestamp" },        "processedAt":   { "type": "datetime",  "required": false, "description": "When processing completed" }      }    },    "AgentMetrics": {      "displayName": "Agent Metrics",      "permissions": { "read": "Admin", "create": "Admin", "update": "Admin", "delete": "Admin" },      "fields": {        "metricId":    { "type": "text",      "required": true,  "description": "Unique metric record ID" },        "agentId":     { "type": "text",      "required": true,  "description": "Agent that produced the metric" },        "metricType":  { "type": "text",      "required": true,  "description": "latency | accuracy | token_usage | throughput | error_rate" },        "value":       { "type": "number",    "required": true,  "description": "Metric value" },        "unit":        { "type": "text",      "required": false, "description": "ms | percent | tokens | count" },        "tags":        { "type": "text",      "required": false, "description": "JSON object with dimension tags" },        "window":      { "type": "text",      "required": false, "description": "Aggregation window: 5min | 1h | 1d" },        "timestamp":   { "type": "datetime",  "required": true,  "description": "Measurement timestamp" }      }    },    "DeploymentLedger": {      "displayName": "Deployment Ledger",      "permissions": { "read": "Admin", "create": "Admin", "update": "Admin", "delete": "Admin" },      "fields": {        "deployId":          { "type": "text",      "required": true,  "description": "Unique deployment ID" },        "version":           { "type": "text",      "required": true,  "description": "Semantic version (e.g. 5.10.1)" },        "status":            { "type": "text",      "required": true,  "description": "pending | in_progress | success | failed | rolled_back" },        "triggeredBy":       { "type": "text",      "required": true,  "description": "Agent or user who initiated" },        "approvedBy":        { "type": "text",      "required": false, "description": "Human who approved" },        "workItemIds":       { "type": "text",      "required": false, "description": "JSON array of included work items" },        "preCheckResults":   { "type": "text",      "required": false, "description": "JSON: tests passed, gate status" },        "healthCheckResult": { "type": "text",      "required": false, "description": "JSON: post-deploy health probe results" },        "rollbackPath":      { "type": "text",      "required": false, "description": "Previous version to rollback to" },        "changelog":         { "type": "text",      "required": false, "description": "Auto-generated changelog text" },        "startedAt":         { "type": "datetime",  "required": true,  "description": "Deploy start time" },        "completedAt":       { "type": "datetime",  "required": false, "description": "Deploy completion time" }      }    },    "TestRunLedger": {      "displayName": "Test Run Ledger",      "permissions": { "read": "Admin", "create": "Admin", "update": "Admin", "delete": "Admin" },      "fields": {        "runId":          { "type": "text",      "required": true,  "description": "Unique test run ID" },        "testPlanId":     { "type": "text",      "required": true,  "description": "Associated test plan" },        "workItemId":     { "type": "text",      "required": true,  "description": "Story / feature under test" },        "totalTests":     { "type": "number",    "required": true,  "description": "Total test count" },        "passed":         { "type": "number",    "required": true,  "description": "Passed count" },        "failed":         { "type": "number",    "required": true,  "description": "Failed count" },        "skipped":        { "type": "number",    "required": false, "description": "Skipped count" },        "coverageScore":  { "type": "number",    "required": false, "description": "Coverage percentage 0-100" },        "regressions":    { "type": "text",      "required": false, "description": "JSON array of regression details" },        "flakyTests":     { "type": "text",      "required": false, "description": "JSON array of flaky test IDs" },        "gateReady":      { "type": "boolean",   "required": true,  "description": "True if release gate criteria met" },        "executedBy":     { "type": "text",      "required": true,  "description": "tst-agent or manual" },        "executedAt":     { "type": "datetime",  "required": true,  "description": "Execution timestamp" }      }    },    "PromptRegistry": {      "displayName": "Prompt Registry",      "permissions": { "read": "Admin", "create": "Admin", "update": "Admin", "delete": "Admin" },      "fields": {        "promptId":      { "type": "text",      "required": true,  "description": "Unique prompt ID" },        "agentId":       { "type": "text",      "required": true,  "description": "Owning agent" },        "version":       { "type": "number",    "required": true,  "description": "Prompt version number" },        "status":        { "type": "text",      "required": true,  "description": "draft | shadow | active | retired" },        "systemPrompt":  { "type": "text",      "required": true,  "description": "Full system prompt text" },        "temperature":   { "type": "number",    "required": false, "description": "LLM temperature override" },        "maxTokens":     { "type": "number",    "required": false, "description": "Token limit override" },        "evalScore":     { "type": "number",    "required": false, "description": "Shadow evaluation score 0-100" },        "baselineId":    { "type": "text",      "required": false, "description": "Prompt ID of baseline for comparison" },        "changeReason":  { "type": "text",      "required": false, "description": "Why this version was created" },        "createdBy":     { "type": "text",      "required": true,  "description": "Author (human or mlo-agent)" },        "createdAt":     { "type": "datetime",  "required": true,  "description": "Creation timestamp" },        "activatedAt":   { "type": "datetime",  "required": false, "description": "When promoted to active" }      }    }  }}