#!/usr/bin/env node/** * ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ *  BANF Bosonto Utsob 2026 ΓÇö Auto Process Management System * ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ * *  Agent Pipeline: *    ΓöîΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÉ    ΓöîΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÉ    ΓöîΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÉ *    Γöé Email Reader  ΓöéΓöÇΓöÇΓöÇΓû╢Γöé Event Analyzer    ΓöéΓöÇΓöÇΓöÇΓû╢Γöé Membership Agent Γöé *    Γöé    Agent      Γöé    Γöé    Agent          Γöé    Γöé                  Γöé *    ΓööΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÿ    ΓööΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÿ    ΓööΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓö¼ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÿ *                                Γöé                        Γöé *                                Γû╝                        Γû╝ *                        ΓöîΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÉ    ΓöîΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÉ *                        Γöé Event Management Γöé    Γöé Payment Agent    Γöé *                        Γöé    Agent          Γöé    Γöé                  Γöé *                        ΓööΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÿ    ΓööΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓö¼ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÿ *                                                         Γöé *                                                         Γû╝ *                                                ΓöîΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÉ *                                                Γöé Communication    Γöé *                                                Γöé Verification     Γöé *                                                ΓööΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÿ * *  Data Sources: *    - banf-crm-reconciliation.json (183 members, family data) *    - membership-drive.js pricing (7 categories ├ù 4 tiers) *    - Live Gmail inbox (via API scan) * *  Output:  bosonto-process-dashboard.html  (self-contained SPA) * ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ */const fs = require('fs');const path = require('path');// ΓöÇΓöÇ Load data ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇfunction loadJSON(f) {  try { return JSON.parse(fs.readFileSync(path.join(__dirname, f), 'utf8')); }  catch { return null; }}const recon = loadJSON('banf-crm-reconciliation.json');const members = (recon && recon.members) || [];// ΓöÇΓöÇ Membership Pricing (from membership-drive.js) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇconst MEMBERSHIP_CATEGORIES = [  {    id: 'm2_eb', name: 'M2 Premium - Early Bird', badge: 'BEST VALUE', icon: '≡ƒÅå',    tagline: 'All 17 events + priority seating. Best overall value.',    highlight: '2.64x value', color: '#8B0000', eventCount: 17, multiplier: 2.64,    pricing: { family: 375, couple: 290, individual: 215, student: 145 },    features: [      'All 17 events fully included',      'Priority seating at all programs',      'Early Bird: save $35 vs standard M2',      'Full family access (adults + all children)',      'Digital magazine & newsletter',      'Member directory & voting rights'    ],    eventsIncluded: ['Bosonto Utsob','Noboborsho','Kids Summer Sports','Summer Workshops Kids','Summer Workshops General','Sports Day','Spondon','Mahalaya','Durga Puja','Lakshmi Puja','Bijoya','Artist Program D1','Artist Program D2','Kali Puja','Natok','Winter Picnic','Saraswati Puja']  },  {    id: 'm2', name: 'M2 Premium', badge: 'ALL-ACCESS', icon: 'Γ¡É',    tagline: 'Full access to all 17 events at standard premium pricing.',    highlight: '2.41x value', color: '#C00020', eventCount: 17, multiplier: 2.41,    pricing: { family: 410, couple: 330, individual: 240, student: 165 },    features: [      'All 17 events fully included',      'Standard premium membership',      'Full family access (adults + all children)',      'Digital magazine & newsletter',      'Member directory & voting rights'    ],    eventsIncluded: ['Bosonto Utsob','Noboborsho','Kids Summer Sports','Summer Workshops Kids','Summer Workshops General','Sports Day','Spondon','Mahalaya','Durga Puja','Lakshmi Puja','Bijoya','Artist Program D1','Artist Program D2','Kali Puja','Natok','Winter Picnic','Saraswati Puja']  },  {    id: 'm1', name: 'M1 Regular', badge: 'ADD-ON ELIGIBLE', icon: '≡ƒôï',    tagline: '11 core religious & social events. Purchase add-ons for cultural events.',    highlight: '2.04x value', color: '#FF6B35', eventCount: 11, multiplier: 2.04,    pricing: { family: 280, couple: 255, individual: 140, student: 100 },    features: [      '11 core events (religious + major social)',      'Cultural/educational via M3 add-ons',      'Full family access for core events',      'Digital magazine & newsletter',      'Member directory & voting rights'    ],    eventsIncluded: ['Bosonto Utsob','Sports Day','Spondon','Mahalaya','Durga Puja','Lakshmi Puja','Bijoya','Kali Puja','Natok','Winter Picnic','Saraswati Puja']  },  {    id: 'cultural', name: 'Cultural Special', badge: 'HIGHEST VALUE', icon: '≡ƒÄ¡',    tagline: '12 cultural, educational & social events. Highest value multiplier.',    highlight: '3.50x value', color: '#D4AF37', eventCount: 12, multiplier: 3.50,    pricing: { family: 180, couple: 140, individual: 100, student: 75 },    features: [      'Bosonto Utsob, Noboborsho, Spondon',      'Summer Workshops (Kids + General)',      'Sports Day, Natok & Winter Picnic',      'Culture & arts focused package'    ],    eventsIncluded: ['Bosonto Utsob','Noboborsho','Kids Summer Sports','Summer Workshops Kids','Summer Workshops General','Sports Day','Spondon','Natok','Winter Picnic','Saraswati Puja']  },  {    id: 'guest', name: 'Guest / Non-Member', badge: 'EVENT ONLY', icon: '≡ƒÄƒ∩╕Å',    tagline: 'Pay per event. No annual commitment required.',    highlight: 'Per event', color: '#78909C', eventCount: 0, multiplier: 0,    pricing: { family: 0, couple: 0, individual: 0, student: 0 },    features: [      'Bosonto Utsob event-day entry',      'No membership benefits',      'Pay at the door',      'Guest registration'    ],    eventsIncluded: ['Bosonto Utsob']  }];const ZELLE_EMAIL = 'banfjax@gmail.com';const ZELLE_NAME = 'BANF Jacksonville';const EVENT_NAME = 'Bosonto Utsob 2026';const EVENT_DATE = '2026-03-21';const PAYMENT_DEADLINE = '2026-04-30';// ΓöÇΓöÇ Extract Bosonto Utsob RSVPs from CRM data ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇconst eviteResponses = [];for (const m of members) {  const bosonto = (m.eventAttendance || []).find(e =>    e.eventName && e.eventName.toLowerCase().includes('bosonto')  );  if (!bosonto) continue;  // Find household members  const hhMembers = (m.householdMembers || []).map(hm => ({    email: hm.email || '',    name: hm.displayName || `${hm.firstName||''} ${hm.lastName||''}`.trim(),    firstName: hm.firstName || '',    lastName: hm.lastName || ''  }));  eviteResponses.push({    email: m.email,    displayName: m.displayName,    firstName: m.firstName,    lastName: m.lastName,    phone: m.phone || '',    address: m.address || '',    city: m.city || '',    state: m.state || '',    zip: m.zip || '',    rsvp: (bosonto.rsvp || '').toLowerCase(),    adults: parseInt(bosonto.adults) || 0,    kids: parseInt(bosonto.kids) || 0,    totalAttendees: parseInt(bosonto.totalAttendees) || 0,    dietary: bosonto.dietary || 'unknown',    source: bosonto.source || 'evite_api',    // CRM historical data    householdType: m.householdType || 'individual',    householdDisplayName: m.householdDisplayName || '',    householdMembers: hhMembers,    previousCategories: m.membershipTypes || [],    membershipYears: m.membershipYears || [],    isActive: m.isActive,    isECMember: m.isECMember || false,    isBOTMember: m.isBOTMember || false,    totalPaid: m.totalPaid || 0,    memberSince: m.memberSince || '',    familyId: m.familyId || m.householdId || '',    inferredKids: m.inferredKids || 0,    communications: m.communications || 0  });}console.log(`≡ƒôï Found ${eviteResponses.length} Bosonto Utsob responses (${eviteResponses.filter(r=>r.rsvp==='yes').length} yes, ${eviteResponses.filter(r=>r.rsvp==='no').length} no)`);// ΓöÇΓöÇ Membership Agent Logic ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ// For each YES RSVP, determine recommended membership + alternativesfunction analyzeMembership(resp) {  const result = {    email: resp.email,    displayName: resp.displayName,    recommended: null,    alternatives: [],    guestOption: null,    reasoning: [],    householdTier: 'individual',    previousTier: null,    upsellOpportunity: false,    upsellFrom: null,    upsellTo: null  };  // Determine household tier from RSVP data  const adults = resp.adults || 1;  const kids = resp.kids || resp.inferredKids || 0;  const prevCats = resp.previousCategories.map(c => c.toLowerCase());  // Was previously couple or family?  const wasFamilyOrCouple = prevCats.some(c => c.includes('family') || c.includes('couple'));  const wasFamily = prevCats.some(c => c.includes('family'));  const wasCouple = prevCats.some(c => c.includes('couple'));  const wasEB = prevCats.some(c => c.includes('eb') || c.includes('early'));  // Determine household tier  if (adults >= 2 && kids > 0) {    result.householdTier = 'family';    result.reasoning.push(`${adults} adults + ${kids} kids ΓåÆ Family tier`);  } else if (adults >= 2) {    result.householdTier = 'family'; // Default to family when 2+ adults    result.reasoning.push(`${adults} adults ΓåÆ Recommended Family tier (can choose Couple)`);  } else if (adults === 1 && wasFamilyOrCouple) {    // Single adult but was previously couple/family    if (wasFamily) {      result.householdTier = 'family';      result.reasoning.push(`1 adult RSVP but previously Family tier ΓÇö recommending Family (spouse may attend separately)`);    } else {      result.householdTier = 'couple';      result.reasoning.push(`1 adult RSVP but previously Couple tier ΓÇö recommending Couple (spouse may attend separately)`);    }    result.upsellOpportunity = true;    result.upsellFrom = 'individual';    result.upsellTo = wasFamily ? 'family' : 'couple';  } else {    result.householdTier = 'individual';    result.reasoning.push(`1 adult, no prior family/couple history ΓåÆ Individual tier`);  }  // Previous tier detection for upsell  if (wasEB && !wasFamily) {    result.previousTier = wasCouple ? 'eb-couple' : 'eb-individual';  } else if (wasFamily) {    result.previousTier = wasEB ? 'eb-family' : 'family';  } else if (wasCouple) {    result.previousTier = 'couple';  }  // Recommend M2 Premium Early Bird (best value)  const tier = result.householdTier;  const m2eb = MEMBERSHIP_CATEGORIES.find(c => c.id === 'm2_eb');  result.recommended = {    category: m2eb,    tier: tier,    price: m2eb.pricing[tier],    reason: 'Best value ΓÇö all 17 events included with priority seating & early bird discount'  };  result.reasoning.push(`Recommended: ${m2eb.name} (${tier}) = $${m2eb.pricing[tier]}`);  // Alternative 1: M1 Regular  const m1 = MEMBERSHIP_CATEGORIES.find(c => c.id === 'm1');  result.alternatives.push({    category: m1,    tier: tier,    price: m1.pricing[tier],    reason: '11 core events. Add cultural events as needed.'  });  // Alternative 2: Cultural Special (if they like cultural events)  const cultural = MEMBERSHIP_CATEGORIES.find(c => c.id === 'cultural');  result.alternatives.push({    category: cultural,    tier: tier,    price: cultural.pricing[tier],    reason: 'Highest value multiplier! 12 cultural + social events, including Bosonto Utsob.'  });  // Alternative 3: M2 Premium (non-early-bird)  const m2 = MEMBERSHIP_CATEGORIES.find(c => c.id === 'm2');  result.alternatives.push({    category: m2,    tier: tier,    price: m2.pricing[tier],    reason: 'All 17 events at standard premium pricing.'  });  // Guest option  const guest = MEMBERSHIP_CATEGORIES.find(c => c.id === 'guest');  result.guestOption = {    category: guest,    tier: tier,    price: 0,    reason: 'Attend Bosonto Utsob as a guest. No annual membership.'  };  // Upsell from regular ΓåÆ premium if they were regular before  if (prevCats.some(c => !c.includes('eb') && !c.includes('early') && !c.includes('premium'))) {    result.upsellOpportunity = true;    result.upsellFrom = 'regular';    result.upsellTo = 'premium-eb';    result.reasoning.push(`Previous non-premium member ΓÇö upsell opportunity to M2 Premium Early Bird`);  }  return result;}// Run membership analysis for all YES RSVPsconst membershipAnalysis = [];for (const resp of eviteResponses) {  if (resp.rsvp === 'yes') {    membershipAnalysis.push(analyzeMembership(resp));  }}// ΓöÇΓöÇ Event Management Aggregation ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇconst eventAgg = {  totalResponses: eviteResponses.length,  yesCount: eviteResponses.filter(r => r.rsvp === 'yes').length,  noCount: eviteResponses.filter(r => r.rsvp === 'no').length,  totalAdults: eviteResponses.filter(r => r.rsvp === 'yes').reduce((s, r) => s + (r.adults || 0), 0),  totalKids: eviteResponses.filter(r => r.rsvp === 'yes').reduce((s, r) => s + (r.kids || 0), 0),  totalAttendees: 0,  vegCount: eviteResponses.filter(r => r.rsvp === 'yes' && r.dietary === 'veg').length,  nonVegCount: eviteResponses.filter(r => r.rsvp === 'yes' && r.dietary === 'non-veg').length,  unknownDiet: eviteResponses.filter(r => r.rsvp === 'yes' && (!r.dietary || r.dietary === 'unknown')).length,  specialDietary: eviteResponses.filter(r => r.rsvp === 'yes' && r.dietary && r.dietary !== 'unknown' && r.dietary !== 'veg' && r.dietary !== 'non-veg')};eventAgg.totalAttendees = eventAgg.totalAdults + eventAgg.totalKids;console.log(`≡ƒôè Event: ${eventAgg.totalAttendees} total attendees (${eventAgg.totalAdults} adults + ${eventAgg.totalKids} kids)`);// ΓöÇΓöÇ Pipeline State: each member goes through stages ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇconst STAGES = [  { id: 'email_scan', name: 'Email Scan', icon: '≡ƒôº', agent: 'Email Reader Agent' },  { id: 'evite_analysis', name: 'Evite Analysis', icon: '≡ƒôè', agent: 'Event Analyzer Agent' },  { id: 'membership_rec', name: 'Membership Selection', icon: '≡ƒÄ»', agent: 'Membership Agent' },  { id: 'payment', name: 'Payment', icon: '≡ƒÆ│', agent: 'Payment Agent' },  { id: 'comm_verify', name: 'Communication Verify', icon: 'Γ£à', agent: 'Communication Verification Agent' },  { id: 'event_mgmt', name: 'Event Management', icon: '≡ƒÄ¬', agent: 'Event Management Agent' }];// Build pipeline records for each responderconst pipelineRecords = [];for (const resp of eviteResponses) {  const ma = membershipAnalysis.find(a => a.email === resp.email);  const record = {    email: resp.email,    displayName: resp.displayName,    firstName: resp.firstName,    lastName: resp.lastName,    phone: resp.phone,    rsvp: resp.rsvp,    adults: resp.adults,    kids: resp.kids,    dietary: resp.dietary,    householdType: resp.householdType,    householdMembers: resp.householdMembers,    previousCategories: resp.previousCategories,    membershipYears: resp.membershipYears,    isActive: resp.isActive,    isECMember: resp.isECMember,    totalPaid: resp.totalPaid,    memberSince: resp.memberSince,    address: resp.address,    city: resp.city,    state: resp.state,    zip: resp.zip,    // Pipeline stages    stages: {      email_scan: { status: 'completed', timestamp: new Date().toISOString(), detail: `Email scanned - RSVP: ${resp.rsvp}` },      evite_analysis: {        status: resp.rsvp === 'yes' ? 'completed' : 'completed',        timestamp: new Date().toISOString(),        detail: resp.rsvp === 'yes'          ? `${resp.adults} adults, ${resp.kids} kids, dietary: ${resp.dietary}`          : 'Declined invitation'      },      membership_rec: {        status: resp.rsvp === 'yes' ? 'pending' : 'skipped',        timestamp: resp.rsvp === 'yes' ? null : new Date().toISOString(),        detail: resp.rsvp === 'yes'          ? (ma ? `Recommended: ${ma.recommended.category.name} (${ma.householdTier}) $${ma.recommended.price}` : 'Awaiting analysis')          : 'N/A - Declined'      },      payment: { status: resp.rsvp === 'yes' ? 'not_started' : 'skipped', timestamp: null, detail: '' },      comm_verify: { status: resp.rsvp === 'yes' ? 'not_started' : 'skipped', timestamp: null, detail: '' },      event_mgmt: {        status: resp.rsvp === 'yes' ? 'pending' : 'completed',        timestamp: resp.rsvp === 'yes' ? null : new Date().toISOString(),        detail: resp.rsvp === 'yes'          ? `Registered: ${resp.adults}A + ${resp.kids}K`          : 'Marked as not attending'      }    },    // Membership analysis (for yes RSVPs)    membershipAnalysis: ma || null,    // User selection state (persisted in LocalStorage)    selectedCategory: null,    selectedTier: null,    selectedPaymentMethod: null,    paymentStatus: 'not_started',    commVerified: false,    userNotes: '',    lastInteraction: null,    resumePoint: null  // Where user left off (for "come back later")  };  pipelineRecords.push(record);}console.log(`≡ƒöä Pipeline: ${pipelineRecords.length} records created`);// ΓöÇΓöÇ Serialize data for HTML injection ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇconst DATA_JSON = JSON.stringify({  event: {    name: EVENT_NAME,    date: EVENT_DATE,    paymentDeadline: PAYMENT_DEADLINE,    zelleEmail: ZELLE_EMAIL,    zelleName: ZELLE_NAME,    venue: 'BANF Community Hall, Jacksonville FL',    capacity: 250  },  categories: MEMBERSHIP_CATEGORIES,  stages: STAGES,  pipeline: pipelineRecords,  aggregation: eventAgg,  generatedAt: new Date().toISOString()});// ΓöÇΓöÇ Read external JS modules ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ// (built as separate files for maintainability)const dashboardJS = fs.readFileSync(path.join(__dirname, 'bosonto-process-dashboard-app.js'), 'utf8');// ΓöÇΓöÇ Generate HTML ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇconst html = `<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>BANF Bosonto Utsob 2026 ΓÇö Process Management Dashboard</title><style>/* ΓöÇΓöÇ Reset & Theme ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */*{margin:0;padding:0;box-sizing:border-box}:root{  --bg:#0f1117;--surface:#1a1d27;--card:#22252f;--border:#2d3040;  --text:#e5e7eb;--muted:#8b8fa3;--accent:#6366f1;--accent2:#a78bfa;  --success:#22c55e;--warn:#f59e0b;--danger:#ef4444;--info:#3b82f6;  --pink:#ec4899;--teal:#14b8a6;  --sidebar-w:240px;--topbar-h:56px;}body{font-family:'Segoe UI',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--text);font-size:14px;line-height:1.5;overflow-x:hidden}a{color:var(--accent2);text-decoration:none}/* ΓöÇΓöÇ Layout ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.sidebar{position:fixed;left:0;top:0;bottom:0;width:var(--sidebar-w);background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;z-index:100}.sidebar .logo{padding:16px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px}.sidebar .logo h1{font-size:.92rem;font-weight:700;background:linear-gradient(135deg,#6366f1,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.sidebar .logo .badge{font-size:.56rem;background:var(--accent);color:#fff;padding:2px 6px;border-radius:6px;letter-spacing:.5px}.sidebar nav{flex:1;padding:12px 10px;overflow-y:auto}.sidebar nav .section-label{font-size:.62rem;text-transform:uppercase;letter-spacing:1px;color:var(--muted);padding:12px 8px 4px;font-weight:600}.sidebar nav button{width:100%;text-align:left;background:none;border:none;color:var(--text);padding:8px 12px;border-radius:8px;cursor:pointer;font-size:.82rem;display:flex;align-items:center;gap:8px;transition:.15s}.sidebar nav button:hover{background:rgba(99,102,241,.08)}.sidebar nav button.active{background:rgba(99,102,241,.15);color:var(--accent2);font-weight:600}.sidebar nav button .count{margin-left:auto;font-size:.68rem;background:var(--card);padding:2px 6px;border-radius:8px;color:var(--muted)}.topbar{position:fixed;top:0;left:var(--sidebar-w);right:0;height:var(--topbar-h);background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 24px;z-index:90}.topbar .title{font-size:.88rem;font-weight:600;display:flex;align-items:center;gap:8px}.topbar .actions{display:flex;gap:8px;align-items:center}.main{margin-left:var(--sidebar-w);margin-top:var(--topbar-h);padding:24px;min-height:calc(100vh - var(--topbar-h))}#content{max-width:1400px;margin:0 auto}/* ΓöÇΓöÇ Cards & Stats ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.stat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-bottom:24px}.stat-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px;position:relative;overflow:hidden}.stat-card .icon{font-size:1.5rem;margin-bottom:6px}.stat-card .value{font-size:1.6rem;font-weight:700;line-height:1.2}.stat-card .label{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}.stat-card .bar{position:absolute;bottom:0;left:0;height:3px;border-radius:0 3px 0 0}/* ΓöÇΓöÇ Pipeline Flow ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.pipeline-flow{display:flex;gap:4px;align-items:center;margin:16px 0;flex-wrap:wrap}.pipeline-stage{display:flex;flex-direction:column;align-items:center;gap:4px;min-width:100px;padding:10px 8px;border-radius:10px;border:1px solid var(--border);background:var(--card);flex:1;text-align:center;transition:.2s}.pipeline-stage.active{border-color:var(--accent);background:rgba(99,102,241,.08)}.pipeline-stage.completed{border-color:var(--success);background:rgba(34,197,94,.06)}.pipeline-stage .stage-icon{font-size:1.3rem}.pipeline-stage .stage-name{font-size:.68rem;font-weight:600;color:var(--muted)}.pipeline-stage .stage-count{font-size:1.1rem;font-weight:700}.pipeline-arrow{font-size:1.2rem;color:var(--muted);flex-shrink:0}/* ΓöÇΓöÇ Table ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.table-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:12px;background:var(--card)}table{width:100%;border-collapse:collapse}thead{background:var(--surface)}th{padding:10px 14px;text-align:left;font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:1px solid var(--border);white-space:nowrap}td{padding:10px 14px;border-bottom:1px solid var(--border);font-size:.82rem;vertical-align:middle}tr:hover{background:rgba(99,102,241,.04)}/* ΓöÇΓöÇ Tags & Badges ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.tag{display:inline-block;padding:2px 8px;border-radius:6px;font-size:.68rem;font-weight:600;margin:1px}.tag.yes{background:rgba(34,197,94,.15);color:#4ade80}.tag.no{background:rgba(239,68,68,.15);color:#f87171}.tag.pending{background:rgba(245,158,11,.15);color:#fbbf24}.tag.completed{background:rgba(34,197,94,.15);color:#4ade80}.tag.active{background:rgba(34,197,94,.15);color:#4ade80}.tag.skipped{background:rgba(139,143,163,.1);color:#8b8fa3}.tag.not_started{background:rgba(139,143,163,.1);color:#8b8fa3}.tag.in_progress{background:rgba(99,102,241,.15);color:#818cf8}.tag.ec{background:rgba(236,72,153,.15);color:#f472b6;margin-left:4px}.tag.premium{background:rgba(139,92,246,.15);color:#a78bfa}.tag.recommended{background:linear-gradient(135deg,rgba(139,0,0,.2),rgba(192,0,32,.2));color:#fca5a5;border:1px solid rgba(192,0,32,.3)}/* ΓöÇΓöÇ Buttons ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.btn{padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-size:.78rem;font-weight:500;transition:.15s;display:inline-flex;align-items:center;gap:6px}.btn:hover{border-color:var(--accent);background:rgba(99,102,241,.08)}.btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}.btn.primary:hover{background:#5558e6}.btn.success{background:var(--success);color:#fff;border-color:var(--success)}.btn.danger{background:transparent;color:var(--danger);border-color:var(--danger)}.btn.sm{padding:4px 8px;font-size:.72rem}.btn.lg{padding:10px 20px;font-size:.88rem}/* ΓöÇΓöÇ Modal ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:200;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px)}.modal{background:var(--surface);border:1px solid var(--border);border-radius:16px;width:90%;max-width:720px;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.5)}.modal-header{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}.modal-header h3{font-size:.92rem;font-weight:700}.modal-body{padding:20px;overflow-y:auto;flex:1}.modal-footer{padding:12px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px}/* ΓöÇΓöÇ Membership Cards ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.membership-card{border:2px solid var(--border);border-radius:12px;padding:16px;margin-bottom:12px;cursor:pointer;transition:.2s;position:relative}.membership-card:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 4px 20px rgba(99,102,241,.15)}.membership-card.selected{border-color:var(--success);background:rgba(34,197,94,.05)}.membership-card.recommended-card{border-color:rgba(192,0,32,.4);background:rgba(139,0,0,.05)}.membership-card .card-badge{position:absolute;top:-8px;right:12px;font-size:.58rem;padding:2px 10px;border-radius:6px;font-weight:700;letter-spacing:.5px}.membership-card .card-header{display:flex;align-items:center;gap:10px;margin-bottom:8px}.membership-card .card-icon{font-size:1.4rem}.membership-card .card-title{font-weight:700;font-size:.88rem}.membership-card .card-price{font-size:1.6rem;font-weight:800;margin:6px 0}.membership-card .card-tagline{font-size:.75rem;color:var(--muted);margin-bottom:8px}.membership-card .card-features{list-style:none;padding:0}.membership-card .card-features li{font-size:.72rem;color:var(--muted);padding:2px 0}.membership-card .card-features li::before{content:'Γ£ô ';color:var(--success);font-weight:700}/* ΓöÇΓöÇ Payment Options ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.payment-option{border:2px solid var(--border);border-radius:12px;padding:14px;margin-bottom:10px;cursor:pointer;transition:.2s;display:flex;align-items:center;gap:12px}.payment-option:hover{border-color:var(--accent)}.payment-option.selected{border-color:var(--success);background:rgba(34,197,94,.05)}.payment-option .po-icon{font-size:1.3rem}.payment-option .po-title{font-weight:600;font-size:.85rem}.payment-option .po-desc{font-size:.72rem;color:var(--muted)}/* ΓöÇΓöÇ Progress Steps ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.progress-steps{display:flex;gap:4px;margin:16px 0}.progress-step{flex:1;height:4px;border-radius:2px;background:var(--border)}.progress-step.done{background:var(--success)}.progress-step.current{background:var(--accent);animation:pulse 1.5s infinite}@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}/* ΓöÇΓöÇ Inline Detail ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.member-process-row{background:var(--surface);border-left:3px solid var(--accent)}.member-process-row td{padding:0!important}.process-detail{padding:20px}.process-detail .section{margin-bottom:16px}.process-detail .section h4{font-size:.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;border-bottom:1px solid var(--border);padding-bottom:4px}/* ΓöÇΓöÇ Communication Verify Form ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.form-group{margin-bottom:12px}.form-group label{display:block;font-size:.72rem;color:var(--muted);margin-bottom:4px;font-weight:600}.form-group input,.form-group select,.form-group textarea{width:100%;padding:8px 12px;background:var(--card);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:.82rem}.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(99,102,241,.1)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}/* ΓöÇΓöÇ QR Placeholder ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.qr-box{width:160px;height:160px;background:var(--card);border:2px dashed var(--border);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:.72rem;color:var(--muted);text-align:center;margin:12px auto}/* ΓöÇΓöÇ Search ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.search-input{padding:8px 14px;background:var(--card);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:.82rem;width:100%;max-width:320px}.search-input:focus{outline:none;border-color:var(--accent)}/* ΓöÇΓöÇ Toast ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.toast{position:fixed;bottom:24px;right:24px;padding:12px 20px;border-radius:10px;font-size:.82rem;font-weight:500;z-index:300;animation:slideUp .3s;box-shadow:0 8px 24px rgba(0,0,0,.3)}.toast.info{background:var(--accent);color:#fff}.toast.success{background:var(--success);color:#fff}.toast.error{background:var(--danger);color:#fff}.toast.warn{background:var(--warn);color:#000}@keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}/* ΓöÇΓöÇ Empty state ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.empty-state{text-align:center;padding:60px 20px;color:var(--muted)}.empty-state .icon{font-size:3rem;margin-bottom:12px}/* ΓöÇΓöÇ Timeline ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */.timeline{position:relative;padding-left:20px}.timeline::before{content:'';position:absolute;left:6px;top:0;bottom:0;width:2px;background:var(--border)}.timeline-item{position:relative;padding:8px 0 8px 16px;font-size:.78rem}.timeline-item::before{content:'';position:absolute;left:-17px;top:12px;width:10px;height:10px;border-radius:50%;border:2px solid var(--border);background:var(--bg)}.timeline-item.done::before{background:var(--success);border-color:var(--success)}.timeline-item.active::before{background:var(--accent);border-color:var(--accent);animation:pulse 1.5s infinite}.timeline-item.pending::before{background:var(--warn);border-color:var(--warn)}/* ΓöÇΓöÇ Responsive ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */@media(max-width:768px){  .sidebar{display:none}  .topbar{left:0}  .main{margin-left:0}  .form-grid{grid-template-columns:1fr}  .stat-grid{grid-template-columns:repeat(2,1fr)}}</style></head><body><!-- ΓòÉΓòÉΓòÉ Sidebar ΓòÉΓòÉΓòÉ --><div class="sidebar">  <div class="logo">    <span style="font-size:1.4rem">≡ƒî╕</span>    <div>      <h1>Bosonto Utsob</h1>      <div class="badge">PROCESS MGMT 2026</div>    </div>  </div>  <nav id="sideNav">    <div class="section-label">Dashboard</div>    <button data-view="dashboard" class="active">      <span>≡ƒôè</span> Overview      <span class="count" id="navTotalCount">0</span>    </button>    <button data-view="pipeline">      <span>≡ƒöä</span> Agent Pipeline    </button>    <div class="section-label">Agents</div>    <button data-view="email_agent">      <span>≡ƒôº</span> Email Reader    </button>    <button data-view="analyzer_agent">      <span>≡ƒôï</span> Event Analyzer    </button>    <button data-view="membership_agent">      <span>≡ƒÄ»</span> Membership Agent      <span class="count" id="navPendingMembership">0</span>    </button>    <button data-view="payment_agent">      <span>≡ƒÆ│</span> Payment Agent      <span class="count" id="navPendingPayment">0</span>    </button>    <button data-view="comm_agent">      <span>Γ£à</span> Comm Verification    </button>    <button data-view="event_agent">      <span>≡ƒÄ¬</span> Event Management    </button>    <div class="section-label">Member Process</div>    <button data-view="member_process">      <span>≡ƒæñ</span> Member Workflows      <span class="count" id="navYesCount">0</span>    </button>    <button data-view="test_member">      <span>≡ƒº¬</span> Test: Ranadhir    </button>    <div class="section-label">Reports</div>    <button data-view="attendance">      <span>≡ƒô¥</span> Attendance Report    </button>    <button data-view="audit">      <span>≡ƒô£</span> Audit Trail    </button>  </nav>  <div style="padding:12px;border-top:1px solid var(--border);font-size:.62rem;color:var(--muted)">    Generated: <span id="genTime"></span>  </div></div><!-- ΓòÉΓòÉΓòÉ Topbar ΓòÉΓòÉΓòÉ --><div class="topbar">  <div class="title">    <span>≡ƒî╕</span> Bosonto Utsob 2026 ΓÇö Auto Process Management  </div>  <div class="actions">    <input class="search-input" id="globalSearch" placeholder="≡ƒöì Search member, email, phone...">    <button class="btn primary" id="refreshBtn">≡ƒöä Refresh Pipeline</button>  </div></div><!-- ΓòÉΓòÉΓòÉ Main Content ΓòÉΓòÉΓòÉ --><div class="main">  <div id="content"></div></div><!-- ΓòÉΓòÉΓòÉ Modal Container ΓòÉΓòÉΓòÉ --><div id="modalContainer"></div><!-- ΓòÉΓòÉΓòÉ Toast Container ΓòÉΓòÉΓòÉ --><div id="toastContainer"></div><script>// ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ// BANF Bosonto Utsob 2026 ΓÇö Process Management Client App// ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ// Injected data from generatorconst INIT_DATA = ${DATA_JSON};// State management with LocalStorage persistenceconst STORAGE_KEY = 'banf_bosonto_process_v1';let STATE = loadState();function loadState() {  try {    const saved = localStorage.getItem(STORAGE_KEY);    if (saved) {      const parsed = JSON.parse(saved);      // Merge saved user selections with fresh pipeline data      const fresh = JSON.parse(JSON.stringify(INIT_DATA));      for (const rec of fresh.pipeline) {        const saved_rec = (parsed.pipeline || []).find(r => r.email === rec.email);        if (saved_rec) {          rec.selectedCategory = saved_rec.selectedCategory;          rec.selectedTier = saved_rec.selectedTier;          rec.selectedPaymentMethod = saved_rec.selectedPaymentMethod;          rec.paymentStatus = saved_rec.paymentStatus || rec.paymentStatus;          rec.commVerified = saved_rec.commVerified || false;          rec.userNotes = saved_rec.userNotes || '';          rec.lastInteraction = saved_rec.lastInteraction;          rec.resumePoint = saved_rec.resumePoint;          // Update stage statuses based on selections          if (rec.selectedCategory) {            rec.stages.membership_rec.status = 'completed';            rec.stages.membership_rec.detail = 'Selected: ' + rec.selectedCategory;            rec.stages.membership_rec.timestamp = saved_rec.lastInteraction;          }          if (rec.selectedPaymentMethod) {            rec.stages.payment.status = rec.paymentStatus === 'paid' ? 'completed' : 'in_progress';            rec.stages.payment.detail = rec.selectedPaymentMethod + (rec.paymentStatus === 'paid' ? ' (Paid)' : ' (Pending)');            rec.stages.payment.timestamp = saved_rec.lastInteraction;          }          if (rec.commVerified) {            rec.stages.comm_verify.status = 'completed';            rec.stages.comm_verify.detail = 'Verified';            rec.stages.comm_verify.timestamp = saved_rec.lastInteraction;          }          // Update personal info if modified          if (saved_rec._editedName) rec.displayName = saved_rec._editedName;          if (saved_rec._editedPhone) rec.phone = saved_rec._editedPhone;          if (saved_rec._editedAddress) rec.address = saved_rec._editedAddress;          if (saved_rec._editedCity) rec.city = saved_rec._editedCity;          if (saved_rec._editedFamilyMembers) rec.householdMembers = saved_rec._editedFamilyMembers;        }      }      fresh.audit = parsed.audit || [];      return fresh;    }  } catch(e) { console.warn('State load error:', e); }  const fresh = JSON.parse(JSON.stringify(INIT_DATA));  fresh.audit = [];  return fresh;}function saveState() {  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(STATE)); } catch(e) {}}function esc(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }function findRecord(email) { return STATE.pipeline.find(r => r.email === email); }${dashboardJS}// ΓöÇΓöÇ Init ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇdocument.getElementById('genTime').textContent = new Date(STATE.generatedAt).toLocaleString();updateNavCounts();render('dashboard');</script></body></html>`;// ΓöÇΓöÇ Write output ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇconst outPath = path.join(__dirname, 'bosonto-process-dashboard.html');fs.writeFileSync(outPath, html, 'utf8');console.log(`Γ£à Generated: ${outPath}`);console.log(`   File size: ${(Buffer.byteLength(html)/1024).toFixed(1)} KB`);